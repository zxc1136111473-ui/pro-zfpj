// Why a source IP was recorded as blocked/suspicious. Drives the future
// inbound-proxy probe-detection feature: a client that PASSES the inbound
// firewall but then times out / fails the handshake is likely a scanner.
enum InboundBlockReason {
  FirewallReject   // dropped by the inbound firewall admission gate (v1)
  HandshakeTimeout // passed firewall, inbound-proxy handshake timed out (future)
  HandshakeFailed  // passed firewall, inbound-proxy handshake errored (future)
  KickedIp         // dropped by account-level kick-IP admission gate (G2)
}

// Which binding layer produced an inbound-firewall reject. Mirrors the worker's
// `InboundLayer` enum. `Unknown` is used for non-firewall reasons (Handshake*)
// and old/partial reports, so the value can safely participate in the unique key
// without Postgres NULL-distinct semantics defeating deduplication.
enum InboundLayer {
  Unknown
  Server // OutboundEndpoint.inboundFirewallRuleSetId — evaluated first, short-circuits
  Port   // Port.inboundFirewallRuleSetId — only reached if the server layer allowed
  ForwarderOwner // ForwardEndpoint owner key (key_id=0)
}

enum InboundBlockedScopeKind {
  Server
  ForwardEndpoint
}

// Whether a firewall reject came from the rule set's default action or an
// explicit matched REJECT rule. Drives the admin "one-click whitelist" hint:
// a `DefaultReject` is overridden by any single ALLOW match, while a
// `RuleReject` requires a higher-priority ALLOW to win.
enum InboundRejectKind {
  NotFirewall   // no firewall reject kind (Handshake* / old reports)
  DefaultReject // no rule matched; fell through to the rule set's defaultAction
  RuleReject    // matched an explicit REJECT rule
}

// Inbound blocked/suspicious source IPs (attacker/scanner audit). Reported
// periodically by zf-worker, deduplicated per (server, port, sourceIp,
// protocol, reason) into aligned 5-minute event-time buckets. GeoIP/ASN are
// NOT stored — resolved at display/export time in zf-web. 30-day retention via
// inbound_blocked_ip_cleanup_service. Admin-only viewing.
model InboundBlockedIp {
  id          Int                @id @default(autoincrement())
  scopeKind   InboundBlockedScopeKind @default(Server)
  scopeId     Int                @default(0)
  keyId       Int                @default(0)
  serverId    Int?               // OutboundEndpoint.id for Server scope; NULL for ForwardEndpoint scope
  port        Int                // dst listen port (u16 widened)
  sourceIp    String             // canonicalized source IP; no geo/asn stored
  protocol    String             // "tcp" | "udp"
  reason      InboundBlockReason @default(FirewallReject)
  // Reject attribution for the admin "whitelist by source" flow. These are part
  // of the dedup key, matching the worker-side aggregation key, so server-layer
  // vs port-layer rejects and default-action vs explicit-rule rejects stay
  // separately attributable. Sentinel values avoid nullable unique-key pitfalls.
  layer       InboundLayer       @default(Unknown)     // binding layer that produced the reject (server/port)
  rejectKind  InboundRejectKind  @default(NotFirewall) // default-action vs explicit-rule reject
  ruleSetId   Int                @default(0)           // EVENT-TIME firewall rule set; 0 = none/unknown
  detail      String?            // free-text (firewall reject reason / future handshake error); not in dedup key
  bucketStart DateTime           // aligned 5-min bucket start, EVENT-TIME from worker
  hitCount    BigInt             @default(0) // BigInt: UDP floods can overflow i32
  firstSeen   DateTime
  lastSeen    DateTime
  createdAt   DateTime           @default(now())

  @@unique([scopeKind, scopeId, keyId, port, sourceIp, protocol, reason, layer, rejectKind, ruleSetId, bucketStart], map: "inbound_blocked_ip_scope_bucket_uq")
  // Query = overlap filter (lastSeen >= start AND firstSeen <= end) ORDER BY lastSeen Desc.
  // serverId+lastSeen drives equality + lastSeen range + ordering; firstSeen<=end is a residual filter.
  @@index([serverId, lastSeen(sort: Desc)], map: "inbound_blocked_ip_server_lastseen_idx")
  @@index([serverId, port, lastSeen(sort: Desc)], map: "inbound_blocked_ip_server_port_lastseen_idx")
  @@index([scopeKind, scopeId, lastSeen(sort: Desc)], map: "inbound_blocked_ip_scope_lastseen_idx")
  @@index([scopeKind, scopeId, port, lastSeen(sort: Desc)], map: "inbound_blocked_ip_scope_port_lastseen_idx")
  @@index([bucketStart], map: "inbound_blocked_ip_bucket_idx") // cleanup scan only
}

// Why a probe-capture session ended. PeerClosed = peer sent EOF before any cap;
// ByteCapped = non-linger mode reached probeCaptureMaxBytes and we closed;
// TimeCapped = hit probeCaptureMaxDurationSecs and we force-closed; Error = read error.
enum ProbeCloseReason {
  PeerClosed
  ByteCapped
  TimeCapped
  Error
  Datagram // a single UDP datagram (first-packet capture); connectionless, duration=0
}

// Captured inbound probe samples (honeypot). For connections REJECTED by an
// inbound firewall rule set with `probeCaptureEnabled`, the worker captures the
// probe: TCP holds the socket and reads up to N bytes + measures duration; UDP
// grabs the first datagram only (connectionless — duration=0, closeReason=Datagram).
// Deduplicated per (scope, port, sourceIp, protocol,
// sampleHash) into aligned 5-min event-time buckets — identical payloads from a
// scanner collapse to one row with a hit counter. Heavier rows (≤4KB bytea) →
// shorter retention than InboundBlockedIp (7d via inbound_probe_sample_cleanup_service).
// Admin-only viewing. GeoIP/ASN + printable preview are resolved at display time
// in zf-web (not stored). Scope体系 reused from InboundBlockedIp; v1 only emits
// Server scope (forwarder capture is deferred).
model InboundProbeSample {
  id          Int                @id @default(autoincrement())
  scopeKind   InboundBlockedScopeKind @default(Server)
  scopeId     Int                @default(0)
  keyId       Int                @default(0)
  serverId    Int?               // OutboundEndpoint.id for Server scope; NULL otherwise
  port        Int                // dst listen port (u16 widened)
  sourceIp    String             // canonicalized source IP; no geo/asn stored
  protocol    String             // "tcp" | "udp"; bound from the record, part of the dedup key
  sampleHash  String             // hex content hash of `sample`; part of the dedup key
  sample      Bytes              // ≤ probeCaptureMaxBytes captured raw bytes
  sampleLen   Int                @default(0) // total observed bytes (may exceed sample length); latest-wins
  durationMsMin  Int             @default(0)
  durationMsMax  Int             @default(0)
  durationMsLast Int             @default(0)
  closeReason ProbeCloseReason   @default(PeerClosed)
  layer       InboundLayer       @default(Unknown) // binding layer that produced the reject (Server/Port)
  ruleSetId   Int                @default(0)       // EVENT-TIME firewall rule set that captured; latest-wins, not in key
  hitCount    BigInt             @default(0)
  bucketStart DateTime           // aligned 5-min bucket start, EVENT-TIME from worker
  firstSeen   DateTime
  lastSeen    DateTime
  createdAt   DateTime           @default(now())

  @@unique([scopeKind, scopeId, keyId, port, sourceIp, protocol, sampleHash, bucketStart], map: "inbound_probe_sample_scope_bucket_uq")
  @@index([serverId, lastSeen(sort: Desc)], map: "inbound_probe_sample_server_lastseen_idx")
  @@index([scopeKind, scopeId, lastSeen(sort: Desc)], map: "inbound_probe_sample_scope_lastseen_idx")
  @@index([scopeKind, scopeId, port, lastSeen(sort: Desc)], map: "inbound_probe_sample_scope_port_lastseen_idx")
  @@index([bucketStart], map: "inbound_probe_sample_bucket_idx") // cleanup scan only
}

