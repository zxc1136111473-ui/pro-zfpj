// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Corresponds to the cargo alias created earlier
  provider = "cargo prisma"
  // The location to generate the client. Is relative to the position of the schema
  output   = "../zfc-prisma/src/prisma.generated.rs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model Subscription {
  id                  Int               @id @default(autoincrement())
  tokenId             String            @unique
  username            String?           @unique
  passwordHash        String?
  ownerAddress        String
  tgUser              String?
  tgChatId            String?
  email               String?           @unique  // 用户邮箱（已验证），用于邮件通知；nullable @unique 允许多个 NULL
  emailVerified       Boolean           @default(false)
  billingType         Int               // 0=Cycle, 1=OneTime, 2=NoSubscription
  basePrice           Int
  recurringPrice      Int
  recurringPriceMode  Int?                           // null/0=与初始相同, 1=固定, 2=相对
  recurringPriceRate  Float?                         // 续费折扣比例，仅 mode=2 时使用
  bandwidth           Int?
  upBandwidth         Int?              // User-specific upload bandwidth limit in Mbps
  downBandwidth       Int?              // User-specific download bandwidth limit in Mbps
  bwLimitType         BwLimitType?      // BandWidht Limit type TotalUpAndDown(using bandwidth) or StandaloneUpAndDown(using upBandwidth and downBandwidth)
  dynamicBw           String?           // DynamicBw it's a json
  traffic             BigInt
  usedTrafficLow      BigInt?
  usedTrafficHigh     BigInt?
  validUntil          DateTime
  resetDays           Int?
  lastReset           DateTime?
  activated           Boolean
  maxPortNumPerServer Int
  totalMaxPorts       Int?              // 所有线路合计端口数上限（可选）; null/<=0 = 不限制
  maxForwardEndpointNum Int             @default(5)
  lines               Int[]
  allowForwardEndpoint        Boolean           @default(false)
  note                String            @default("")
  ports               Port[]
  allowIpNum          Int?
  allowConnNum        Int?
  packageId           Int?              // 关联的套餐ID
  package             Package?          @relation(fields: [packageId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  ForwardEndpoint     ForwardEndpoint[]
  isAdmin             Boolean           @default(false)
  lineUsages          SubscriptionLineUsage[]
  createdLatencyConfigs LatencyTestConfig[]
  createdForwarderLatencyConfigs ForwarderLatencyTestConfig[] @relation("ForwarderLatencyCreator")
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  orders              Order[]
  balance             Int               @default(0) // 用户余额，单位为分
  autoRenewal         Boolean           @default(true)   // 到期自动续费开关
  autoRenewalTryCnt   Int?              @default(0)       // 续费失败计数（仅诊断/展示，不再做永久闩锁）
  autoTrafficTopup    Boolean           @default(false)   // 流量用完自动买流量包（独立于到期续费）
  bonusTrafficBytes   BigInt            @default(0)       // 当期补充流量额度（字节），上限=traffic*1GB+bonus；重置时清零
  topupCountThisPeriod Int              @default(0)       // 当期已自动补流量次数（防刷爆，重置时清零）
  // 非空 = 已提交变更并调度了异步清零，尚未落地（auto-renewal-overdue-grace 守卫 A）
  resetPendingSince   DateTime?
  cycleDays           Int?
  alerts              Alert[]
  redeemCodes         RedeemCode[]      // 关联的兑换码
  invitationCodeUsages InvitationCodeUsage[] // 关联的邀请码使用记录
  trafficMatchRules    TrafficMatchRule[]    @relation("TrafficMatchRuleOwner")
  trafficOutboundSelectors TrafficOutboundSelector[] @relation("TrafficOutboundSelectorOwner")
  trafficRules         TrafficRule[]         @relation("TrafficRuleOwner")
  trafficRuleSets      TrafficRuleSet[]      @relation("TrafficRuleSetOwner")
  firewallRules        FirewallRule[]        @relation("FirewallRuleOwner")
  firewallRuleSets     FirewallRuleSet[]     @relation("FirewallRuleSetOwner")
  allowServerMonitoring Boolean?              // null=跟随套餐/系统设置, true=允许, false=禁止
  allowInboundProxy   Boolean?              // null=不限制(跟随服务器), true=允许, false=禁止
  // 入站代理协议「变体级」白名单（订阅级 entitlement）。空=不限制；含 kind 键(如 "vless")或
  // variant 键(如 "vless-enc"/"vless-plain")。与 server/组/共享的 capability 取 AND（仅自定义订阅生效，
  // 套餐订阅只看 package/packageLine，镜像 allowInboundProxy 的 coarse 语义）。
  allowedInboundProtocols String[]          @default([])
  periodUnit          Int?                           // 0=DAY, 1=MONTH, 2=QUARTER(3months), 3=YEAR; null=legacy fallback to cycleDays
  periodCount         Int?                           // 周期数值（天数或月数等）; null=legacy fallback
  anchorDay           Int?                           // 锚点日（1-31），自然月时用于月末恢复
  trafficResetDays    Int?                           // 独立的流量重置天数，null=跟随订阅周期
  // 推广返利相关
  referralCode        String?           @unique       // 8字符推广码（注册或首次访问时懒生成）
  referralBalance     Int               @default(0)   // 推广钱包余额（分），独立于 balance
  referredById        Int?                            // 推荐人的 subscription.id
  registrationIp      String?                         // 注册时 IP（反作弊用）
  commissionComponentId Int?                          // 推广成分外键，null=使用系统默认
  commissionComponent   ReferralCommissionComponent? @relation("SubscriptionCommissionComponent", fields: [commissionComponentId], references: [id], onDelete: SetNull)
  referrals           ReferralRelationship[] @relation("Referrer")
  referredRelation    ReferralRelationship?  @relation("Referred")
  referralCommissionsEarned  ReferralCommission[] @relation("CommissionEarner")
  referralTransactions       ReferralTransaction[]
  referralWithdrawals        ReferralWithdrawal[]
  withdrawalAccounts         WithdrawalAccount[]
  // 订阅链接（自动生成多平台订阅）额度/开关/拉取安全策略；全部 null=继承(package/system)
  subLinkEnabled             Boolean?       // 功能开关（null=继承 package/system）
  maxSubTemplates            Int?           // 最大模板数（null=继承）
  maxSubLinks                Int?           // 最大订阅链接数（null=继承；系统默认 1）
  subFetchFirewallRuleSetId  Int?           // 管理员指派的拉取防火墙规则集（CIDR/ASN），用户不可改
  subFetchFirewallRuleSet    FirewallRuleSet? @relation("SubFetchFirewall", fields: [subFetchFirewallRuleSetId], references: [id], onDelete: SetNull)
  subFetchUaPolicyJson       String?        // typed-JSON: SubFetchUaPolicy，管理员专属
  subFetchMinIntervalSecs    Int?           // 生产拉取最小间隔秒数（null=继承系统；0=不限流）
  // 端口入站防火墙策略 override；null=继承套餐（运行期动态读 Package，非购买快照）
  defaultInboundFirewallRuleSetId Int?
  defaultInboundFirewallRuleSet   FirewallRuleSet? @relation("SubscriptionDefaultInboundFirewall", fields: [defaultInboundFirewallRuleSetId], references: [id], onDelete: SetNull)
  inboundFirewallRequired         Boolean?       // null=继承套餐；true=强制选规则集
  subscriptionTemplates      SubscriptionTemplate[] @relation("SubTemplateOwner")
  subscriptionLinks          SubscriptionLink[]
  subLinkFetchLogs           SubLinkFetchLog[]
  kickedIps                  KickedIp[]
  adminRoleAssignments       AdminRoleAssignment[]
  userSessions               UserSession[]
  // 多租户：所属租户（null=平台）。创建后不可变；isTenantAdmin 仅在"创建租户"事务里置 true（一租户一管理账号）
  tenantId                   Int?
  tenant                     Tenant?  @relation(fields: [tenantId], references: [id])
  isTenantAdmin              Boolean  @default(false)
  @@index([tenantId])
  @@index([subFetchFirewallRuleSetId])
  @@index([defaultInboundFirewallRuleSetId])
  @@index([tokenId])
  @@index([username])
  @@index([ownerAddress])
  @@index([billingType])
  @@index([tokenId, ownerAddress])
  @@index([bandwidth])
  @@index([validUntil(sort: Desc)])
  @@index([packageId])
  @@index([referralCode])
  @@index([referredById])
  @@index([commissionComponentId])
  // 自动补流量轮询候选扫描：把 `剩余≤1GB` 算式过滤限定在开启 topup 的子集上。
  @@index([autoTrafficTopup, activated, billingType])
}

// ========== 面板登录会话（login-session-mgmt）==========
// id = UUID v4 = JWT sid；关联 Subscription.id（不可变），不挂 tokenId（可轮换）。
model UserSession {
  id             String    @id
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastActiveAt   DateTime  @default(now())
  ip             String
  userAgent      String    @default("")
  loginMethod    String    @default("password") // password | token
  revokedAt      DateTime?
  revokedBy      String?   // actor token_id
  revokeReason   String?   // user_self | user_others | admin | token_rotation | password_change

  @@index([subscriptionId, revokedAt])
  @@index([subscriptionId, createdAt])
  @@index([expiresAt])
}

