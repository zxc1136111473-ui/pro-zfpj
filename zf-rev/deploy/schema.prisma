model OutboundEndpoint {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  pubkey       String   @unique
  displayName  String
  hidden       Boolean  @default(true)
  ingressIpv4  String
  portStart    Int?
  portEnd      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ports        Port[]
  trafficScale Float?
  allowForward Boolean? @default(true)
  allowLatencyTest Boolean? @default(false)
  allowIpNum          Int?
  allowConnNum        Int?
  privateKey String?
  interfaceName String?
  version String?
  proxyConfig String?
  relatedForwardEndpointIds Int[]
  /// JSON of `Vec<ForwardEndpointPolicy>` (weight/tier per related id). NULL = no policy.
  forwardEndpointPolicies String?
  balanceStrategy   Int?
  allowIpV6      Boolean       @default(false)
  useForwardAsTun Boolean? @default(false)
  protocolFilters String[]     @default([])
  ipVersionPriority String?     @default("default")
  relatedTotServerIds Int[]
  totServerTestMethod Int?
  totServerSelectMode Int?
  totSendMode         Int?
  forwardMode         String?   // direct | relay | chain | tot; NULL = derive from legacy columns (对齐 Port.forwardMode)
  totSubStreams       String?   // TOT 高级子流(链式/多端点优选) JSON of Vec<TotSubStreamSpec>; NULL = 回退扁平 relatedTotServerIds
  forwardChainIds Int[] @default([])
  forwardChainTestMethod Int? @default(0)
  forwardChainSmartSelect Boolean? @default(true)
  forwardChainFixedHopsNum  Int?
  forwardChainFixedLastHopsNum Int?
  latencyTestConfigs LatencyTestConfig[]
  customConfig String?
  tags         String[]     @default([])
  bandwidth                 Int?              // Server-specific bandwidth limit in Mbps
  upBandwidth               Int?              // Server-specific upload bandwidth limit in Mbps
  downBandwidth             Int?              // Server-specific download bandwidth limit in Mbps
  bwLimitType               BwLimitType?           // BandWidht Limit type TotalUpAndDown(using bandwidth) or StandaloneUpAndDown(using upBandwidth and downBandwidth)
  serverGroupId             Int?              // 所属服务器组ID
  serverGroup               ServerGroup?      @relation(fields: [serverGroupId], references: [id])
  isGroup                   Boolean?          // 是否这个服务器是一个组
  autoAdd                   Boolean           @default(false) // 是否自动添加的服务器
  forceUsingFwd             Boolean           @default(false) // 强制必须使用转发端点，禁止直连, 开启allowForward的情况下才生效
  enableFwdChainMode        Boolean           @default(true)  // 允许使用转发链模式, 开启allowForward的情况下才生效
  UdpSISO                   Boolean           @default(false) // UDP原进原出
  allowInboundProxy         Boolean           @default(false) // 允许inbound代理
  allowedInboundProtocols   String[]     @default([]) // 入站协议白名单(mode=Override时生效)；空=放开全部7种
  inboundProtocolPolicyMode Int          @default(0)  // 0=Inherit(随组), 1=Override(用本机allowedInboundProtocols)
  forceInboundProxy         Boolean?                  // 强制入站代理：null=随组, true/false=覆盖
  extraInboundAddress       String[]     @default([]) // 额外入口IP地址列表
  enableRemoteShell         Boolean      @default(false)

  // 跨面板服务器共享（shared-server-cross-panel-design §4）
  // A 侧：true = 共享出去的影子服务器行——不出现在常规服务器列表/监控/选路，
  // 禁止建端口（INV-2）；owner 连接接受/版本/统计/设备计数 key 在此行上。
  isSharedOutServer    Boolean @default(false)
  // B 侧：true = 从其他面板导入的共享服务器；privateKey 为空占位（B 永不持有
  // 私钥），安装/卸载/离线包/refreshKeys/shell/升级入口后端硬拒（§10.3）。
  isSharedImportServer Boolean @default(false)
  serverShare          ServerShare?
  importedServerShare  ImportedServerShare?

  // Server Suspend/Pause
  isSuspended             Boolean   @default(false)
  suspendType             Int?      // 0=manual, 1=traffic_exceeded, 2=port_expired, 3=shared_share_suspended(共享配额用尽/A 暂停)
  suspendedAt             DateTime?
  resumeAt                DateTime? // auto-resume time (manual pause only)

  // Traffic Control (mirrors ForwardEndpoint pattern)
  periodTraffic           Int?      // GB limit per period (raw, unscaled)
  trafficResetPeriodDays  Int?      // reset cycle in days
  periodStartDate         DateTime?
  // NOTE: periodUsedTraffic 为三套 high/low（合计 + 入向 + 出向）。任何写/清/重置周期用量
  // 的代码路径必须三套同写，否则合计与方向漂移、切方向模式时误暂停。
  periodUsedTrafficHigh   BigInt?   // 合计 high 64 bits (= in + out)
  periodUsedTrafficLow    BigInt?   // 合计 low 64 bits
  periodUsedTrafficInHigh  BigInt?  // 入向(下行/download/traffic_in) high
  periodUsedTrafficInLow   BigInt?  // 入向 low
  periodUsedTrafficOutHigh BigInt?  // 出向(上行/upload/traffic_out) high
  periodUsedTrafficOutLow  BigInt?  // 出向 low
  periodTrafficLimitMode   PeriodTrafficLimitMode? // null = TotalInOut（默认，比较合计列）

  // Billing info (informational only, does NOT trigger suspend)
  billingExpireAt          DateTime?
  billingCycle             BillingCycle?
  billingAmount            String?       // free text, e.g. "￥100", "$10"
  autoRenew                Boolean       @default(true) // 到期后按 billingCycle 自动推进 billingExpireAt（不扣费）；关则纯手动

  // Server-level firewall bindings (rule sets authored under Traffic Routing).
  // Inbound is consumed by the worker in v1; outbound is stored only and
  // becomes live in a follow-up (see server-inbound-firewall-design §9).
  inboundFirewallRuleSetId  Int?
  inboundFirewallRuleSet    FirewallRuleSet? @relation("ServerInboundFirewall", fields: [inboundFirewallRuleSetId], references: [id], onDelete: SetNull)
  outboundFirewallRuleSetId Int?
  outboundFirewallRuleSet   FirewallRuleSet? @relation("ServerOutboundFirewall", fields: [outboundFirewallRuleSetId], references: [id], onDelete: SetNull)

  // 动态 IP 出口：节点自探测公网出口并上报，供同租界 forwarder 入站防火墙豁免层合成。
  dynamicIp               Boolean @default(false)
  // 类型化 JSON: Vec<ReportedEgressIp{ip,last_seen}>；上报整列替换，上限 16 条。
  reportedEgressIpsJson   String  @default("[]")
  // 动态入口地址：把 dynamicIp 探测到的公网出口 IP 同时用作连接地址（P5，
  // 复用 dynamic-ingress-address 设计 §4.1 resolver，语义与 ForwardEndpoint.dynamicIngress 对称）。
  dynamicIngress           Boolean @default(false)

  // 入口 IP 变更通知代次（seq 驱动，见 design dynamic-ingress-notify-and-ddns §4.1）
  // ingressNotifySeq：开关开启期间投影每变一次 +1
  // lastNotifiedIngressSeq：已通知到的代次（ACK）
  // 不变量：0 <= lastNotifiedIngressSeq <= ingressNotifySeq（additive CHECK 在 upgrader）
  ingressNotifySeq         BigInt  @default(0)
  lastNotifiedIngressSeq   BigInt  @default(0)

  // 多租户：所属租户（null=平台）
  tenantId                 Int?
  tenant                   Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([hidden])
  @@index([pubkey])
  @@index([tags])
  @@index([serverGroupId])
  @@index([isSuspended])
  @@index([inboundFirewallRuleSetId])
  @@index([outboundFirewallRuleSetId])
  @@index([tenantId])
}

model ForwardEndpoint {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  displayName    String
  ingressAddress String
  extraIngressAddress String[] // 额外IP地址
  servePort      Int
  innerPort      Int?
  protocol       String // server protocol socks5 or hammer, current only support hammer
  protocolConfig String // protocol config json
  privKey        String // ws private key
  wsPort         Int? // ws port
  password       String?
  isPublic       Boolean       @default(false) // is public for all users
  subscriptionId Int? // belong to which subscription user
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  setupScript    String?
  tokenId        String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  trafficScale   Float?
  allowIpV6      Boolean       @default(false)
  autoAdd        Boolean       @default(false)
  upBandwidth               Int?              // Server-specific bandwidth limit in Mbps
  downBandwidth             Int?              // Server-specific bandwidth limit in Mbps
  bwLimitType               BwLimitType?           // BandWidht Limit type TotalUpAndDown(using bandwidth) or StandaloneUpAndDown(using upBandwidth and downBandwidth)
  autoIp         Boolean      @default(false) // auto ip
  // P0-B auto-IP capability secret (envelope): hash for verify, enc1 for re-embed on setup.
  // AAD = auto_ip|{endpoint_id}. Null = legacy path (device token_id for update-ip, Release N).
  autoIpCredHash   String?    // sha256 hex of plaintext AUTO_IP_CRED
  autoIpSecretEnc  String?    // enc1... AEAD of plaintext AUTO_IP_CRED
  isGroup        Boolean      @default(false) // is a special fwd endpoint which is a group
  groupId        Int?                         // if is a fwd group, the referenced fwd group id
  UdpSISO        Boolean      @default(false) // UDP原进原出
  enableUOT    Boolean       @default(false) // 使用UOT，而非原生UDP
  tasks          ForwarderTask[] // 关联的任务
  enable         Boolean      @default(true)
  trafficResetPeroidDays  Int?  // 流量重置周期天数，用来判断是否实际启用这个转发端点
  periodTraffic           Int? // Unit: GB 周期内流量数量，如果周期内超过这个值，则禁用转发端点
  periodStartDate   DateTime?
  // NOTE: periodUsedTraffic 为三套 high/low（合计 + 入向 + 出向），写/清/重置须三套同写。
  periodUsedTrafficHigh   BigInt?  // 合计 high (= in + out)
  periodUsedTrafficLow    BigInt?  // 合计 low
  periodUsedTrafficInHigh  BigInt? // 入向(下行/download) high
  periodUsedTrafficInLow   BigInt? // 入向 low
  periodUsedTrafficOutHigh BigInt? // 出向(上行/upload) high
  periodUsedTrafficOutLow  BigInt? // 出向 low
  periodTrafficLimitMode   PeriodTrafficLimitMode? // null = TotalInOut（默认）
  customConfig String?  // 自定义配置json格式
  tags         String[]     @default([])
  isSuspended             Boolean   @default(false)
  // 0=manual, 1=traffic_exceeded, 3=share_revoked, 4=share_expired, 5=share_suspended(local-only projection)
  suspendType             Int?
  suspendedAt             DateTime?
  resumeAt                DateTime?
  latencyTestConfigs  ForwarderLatencyTestConfig[]
  sslCertificateId  Int?
  sslCertificate    SslCertificate? @relation(fields: [sslCertificateId], references: [id])
  sslSyncPending    Boolean         @default(false)
  // Billing info (informational only, does NOT trigger suspend)
  billingExpireAt   DateTime?
  billingCycle      BillingCycle?
  billingAmount     String?
  autoRenew         Boolean       @default(true) // 到期后按 billingCycle 自动推进 billingExpireAt（不扣费）；关则纯手动
  // [deprecated since 多密钥共享 v2] v1 互斥锁定标记，恒为 false，不再读写。
  // v2 中 A 与 B 面板同时使用端点（per-share 独立密钥），不存在锁定语义。
  sharedOut         Boolean   @default(false)
  // 跨面板共享（B 侧）：true = 该端点是从其他面板导入的共享端点，
  // 密码/连接信息永不暴露给前端，禁止编辑/复制/改密码/部署脚本。
  isSharedImport    Boolean   @default(false)
  // 多密钥共享 v2：该端点 forwarder KeyRing 的版本号（端点级单调递增）。
  // 任何 share 状态/白名单变化 +1 并推送 forwarder；heartbeat 对账补推。
  keyringRevision   BigInt    @default(0)
  // 跨面板连接真相 revision：A 修改 worker→forwarder 建连白名单字段时 +1；
  // B 通过 S2S status/report 拉取 SharedClientConnectInfo 对齐。
  connectRevision   BigInt    @default(0)
  // Owner 入站防火墙：仅 key_id=0 生效；revision 用于热更新与 heartbeat 对账。
  inboundFirewallRuleSetId Int?
  inboundFirewallRuleSet   FirewallRuleSet? @relation("ForwarderInboundFirewall", fields: [inboundFirewallRuleSetId], references: [id], onDelete: SetNull)
  inboundFirewallRevision  BigInt    @default(0)
  // 动态 IP 出口：节点自探测公网出口并上报；豁免层 revision 与 keyring/inbound 同族。
  dynamicIp                Boolean   @default(false)
  // 动态入口地址：把 dynamicIp 探测到的公网出口 IP 同时用作连接地址（供其他
  // forwarder/worker 连接），绕过 DDNS 更新延迟。开启要求 dynamicIp=true。
  // source ∈ {Probe, Local} 且公网可路由的 IP 入选（resolver 侧过滤；代码权威，
  // 旧注释写「仅 Probe」有误）。P4 前 shared-out 硬拒。
  dynamicIngress           Boolean   @default(false)
  // 类型化 JSON: Vec<ReportedEgressIp{ip,last_seen}>；上报整列替换，上限 16 条。
  reportedEgressIpsJson    String    @default("[]")
  dynamicExemptRevision    BigInt    @default(0)
  shares            ForwardEndpointShare[]
  importedShare     ImportedEndpointShare?
  // 多租户：所属租户（null=平台）。与 subscriptionId（用户私有归属）正交：tenantId 是租界维度
  tenantId          Int?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  @@index([tokenId])
  @@index([tags])
  @@index([isSuspended])
  @@index([inboundFirewallRuleSetId])
  @@index([tenantId])
}

// 共享配额模式：一次性总额 / 周期重置
enum ShareQuotaMode {
  OneTime
  Periodic
}

// 共享状态机（A/B 两侧复用同一 enum）。多密钥 v2 语义：
// PendingImport: 共享码已生成，B 尚未导入（share key 不进 KeyRing）
// Active: 正常共享中（share key 进 KeyRing，携带该 share 的 CIDR 白名单）
// Suspended: 当期配额用尽，软暂停（key 移出 KeyRing + 存量连接即断，周期到点自动恢复）
// Expired: 到期（终态，可显式重新激活——v2 不轮换主密码，无轮换障碍）
// Revoked: 已吊销（终态，key 移出 KeyRing + 存量连接即断）
enum ForwardEndpointShareStatus {
  PendingImport
  Active
  Suspended
  Expired
  Revoked
}

// A 侧（Owner）共享记录：多密钥 v2，每个端点至多 16 条非终态 share 并存（业务约束），
// 每条 share 一个独立 sharePassword（= forwarder KeyRing 中的一个 key，key_id = share.id）。
model ForwardEndpointShare {
  id                     Int                        @id @default(autoincrement())
  forwardEndpointId      Int
  forwardEndpoint        ForwardEndpoint            @relation(fields: [forwardEndpointId], references: [id], onDelete: Cascade)
  status                 ForwardEndpointShareStatus @default(PendingImport)
  // 配额
  quotaMode              ShareQuotaMode             @default(OneTime)
  quotaTrafficGb         Int? // null = 不限流量
  resetPeriodDays        Int? // Periodic 模式的重置周期天数
  periodStartDate        DateTime? // 当前周期起点（A 时钟）
  expireAt               DateTime? // 共享有效期截止（A 时钟），null = 不限
  // S2S 鉴权：只存 sha256(token) 十六进制；import 成功后轮换
  shareTokenHash         String                     @unique
  shareCodeUsedAt        DateTime? // 共享码被消费（import 成功）时间
  // 多密钥 v2：该 share 的独立密码（创建时生成，import 响应交给 B；
  // 进入 forwarder KeyRing 作为候选 key，key_id = share.id）。明文存储与端点主密码同级敏感。
  sharePassword          String                     @default("")
  // per-key 入站白名单（forwarder 握手命中该 key 后校验源 IP）
  manualCidrs            String[]                   @default([])
  // B 上报的 worker 出口 IP 集合，类型化 JSON: Vec<PeerWorkerIp{ip,last_seen}>
  peerWorkerIpsJson      String                     @default("[]")
  // [deprecated since v2] per-share 白名单 revision，已被端点级 ForwardEndpoint.keyringRevision 取代
  whitelistRevision      BigInt                     @default(0)
  // 旧版 forwarder（Heartbeat 不带 keyring_revision = 不支持多密钥）告警标记
  whitelistUnsupported   Boolean                    @default(false)
  // A 侧管理员备注（价格、联系方式等，不同步给 B 端）
  note                   String?
  // 对端（B 面板）信息
  peerPanelName          String?
  peerInstanceId         String?
  peerLastSyncAt         DateTime?
  // 计量：B 上报的"自导入起累计入账字节"（max 合并，单调），128-bit 拆 high/low
  reportedCumulativeHigh BigInt                     @default(0)
  reportedCumulativeLow  BigInt                     @default(0)
  // 周期起点快照：当期已用 = reportedCumulative - periodBase
  periodBaseHigh         BigInt                     @default(0)
  periodBaseLow          BigInt                     @default(0)
  // 多密钥 v2 对账（第二计量源）：forwarder per-key 字节计数（线上字节口径）。
  // fwdrAccum = share 生命周期累计总量（delta 累加：new>=lastSeen 加差值，new<lastSeen 视为
  // forwarder 重启清零、加 new）；fwdrLastSeen = 上次样本原始值（回绕检测用）。
  fwdrAccumRx            BigInt                     @default(0)
  fwdrAccumTx            BigInt                     @default(0)
  fwdrLastSeenRx         BigInt                     @default(0)
  fwdrLastSeenTx         BigInt                     @default(0)
  // 出向防火墙内联策略，类型化 JSON: OutboundSharePolicy；null = 未配置
  // （forwarder 仍强制内建基线：私网/回环/本机 IP 拒绝）
  outboundPolicyJson     String?
  // per-key 限速配置，类型化 JSON: ShareBandwidthLimitDto；null = 不限速
  bandwidthLimitJson     String?
  // 出向防火墙拦截计数（delta 累加，同 fwdrAccumRx 模式；口径 = 被拒候选地址次数）
  fwdrAccumRejects       BigInt                     @default(0)
  fwdrLastSeenRejects    BigInt                     @default(0)
  // 双源偏差告警节流：最近一次对账告警时间
  reconcileAlertAt       DateTime?
  // [deprecated since v2] 吊销不再轮换主密码（per-share key 独立，移除 key 即硬吊销）
  rotatePasswordOnRevoke Boolean                    @default(true)
  revokedAt              DateTime?
  // [deprecated since v2] v1 密码轮换标记，不再读写
  passwordRotated        Boolean                    @default(false)
  // B 主动释放（B 删除本地端点时尽力上报）
  releasedByPeer         Boolean                    @default(false)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([forwardEndpointId])
  @@index([status])
}

// B 侧（Consumer）导入记录：与本地 ForwardEndpoint 一对一。
model ImportedEndpointShare {
  id                 Int                        @id @default(autoincrement())
  forwardEndpointId  Int                        @unique
  forwardEndpoint    ForwardEndpoint            @relation(fields: [forwardEndpointId], references: [id], onDelete: Cascade)
  // A 面板基础 URL（可编辑，应对 A URL 变更）
  peerPanelUrl       String
  peerShareId        Int
  // B 持有的明文 token（调 A 的 S2S API 用；import 时 A 已轮换，原共享码作废）
  shareToken         String
  // 本面板实例 ID（防克隆：A 校验 report.instanceId 一致性）
  instanceId         String
  status             ForwardEndpointShareStatus @default(Active)
  // A 回显的配额/用量
  quotaMode          ShareQuotaMode             @default(OneTime)
  quotaTrafficGb     Int?
  resetPeriodDays    Int?
  periodStartDate    DateTime?
  expireAt           DateTime?
  usedTrafficHigh    BigInt                     @default(0)
  usedTrafficLow     BigInt                     @default(0)
  // 上报基线：处理 B 侧 Redis 清零的分段累加，保证上报单调
  // cumulative = reportBase + 当前 Redis 值；Redis 回落则 reportBase += lastRedisValue
  reportBaseHigh     BigInt                     @default(0)
  reportBaseLow      BigInt                     @default(0)
  lastRedisValueHigh BigInt                     @default(0)
  lastRedisValueLow  BigInt                     @default(0)
  // 流量统计去 Redis(§9)：上次同步看到的 fwd period_start_date。
  // 重置检测从「值下跳」换成「period_start 推进」，避免控制器重启 blip 误判重置 over-bill。
  lastSeenPeriodStart DateTime?
  // A 回显的限速配置快照（只读展示，sync 时刷新），类型化 JSON: ShareBandwidthLimitDto
  bandwidthLimitJson String?
  // 对端（A 面板）展示名
  peerPanelName      String?
  // A 时钟与 B 时钟偏差（毫秒，A server_time - B now），>5min UI 提示
  serverTimeOffsetMs BigInt?
  lastSyncAt         DateTime?
  lastSyncError      String?
  lastSyncErrorAt    DateTime?
  // 已应用的 A 侧 connectRevision；-1 = 从未应用（升级/import 后强制对齐一次）。
  lastConnectRevision BigInt                    @default(-1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([status])
}

// ===========================================================================
// 跨面板服务器共享（shared-server-cross-panel-design.md）
// A 面板（Owner）拥有机器并强制限制；B 面板（Tenant）在限制内运营。
// 与端点共享角色相反：共享码由 B 生成，token 明文由 A 持有，S2S 仅 A→B。
// ===========================================================================

// 共享服务器状态机（§3.2）。每侧合法子集不同：
// PendingImport 仅 B 侧（邀请未被消费）；PendingInstall 仅 A 侧（已导入、
// worker 从未连上，B 侧映射为 Active+离线）。其余两侧同义。
enum ServerShareStatus {
  PendingImport
  PendingInstall
  Active
  Suspended // 配额用尽/A 手动暂停（worker 停全部 tenant 端口）
  Expired // 到期（终态，可显式重激活）
  Revoked // A 吊销（终态）
  Released // B 主动释放（终态，A 收到后提示卸载）
}

// A 侧（Owner）共享记录：与影子服务器行一对一（§4.1）。
// 限制配置 lower 成 wire SharedLimits 经 owner 连接下发 worker 强制执行；
// 核算数据来自 worker 第一手 SharedUsageReport（max 合并）。
model ServerShare {
  id                 Int               @id @default(autoincrement())
  outboundEndpointId Int               @unique
  outboundEndpoint   OutboundEndpoint  @relation(fields: [outboundEndpointId], references: [id], onDelete: Cascade)
  status             ServerShareStatus @default(PendingInstall)

  // ---- S2S 客户端材料（A 是调用方，与端点共享相反）----
  peerPanelUrl         String // B 面板 URL（来自共享码）
  peerInviteId         Int // B 侧 ImportedServerShare.id
  shareToken           String // A 持有的明文 token（import 后已轮换）
  instanceId           String // A 面板实例 ID（幂等/防克隆）
  peerPanelName        String?
  peerMinWorkerVersion String? // B 声明的最低 worker 版本（push 响应回带刷新）
  peerLastPushAt       DateTime?
  lastPushError        String?
  lastPushErrorAt      DateTime?

  // ---- 两阶段导入中间态（#1 分布式原子性，prepare/confirm/abort）----
  // importConfirmedAt = NULL 且 pendingPeerToken 非空 = 本地已提交但 B 尚未 confirm
  // 的「在途」行；confirm 成功后落 importConfirmedAt 并清空 pendingPeerToken。
  // 老数据两列皆 NULL → 天然视为已确认（无需回填，见 share_import_pending）。
  importConfirmedAt DateTime? // B 已 confirm 的时刻；NULL=在途/老数据
  pendingPeerToken  String? // 原始共享码 token（鉴权 confirm/abort/re-prepare），confirm 成功即清空

  // ---- B（tenant）控制面接入信息（S2S import 响应回带，安装脚本写入
  // config.json 顶层 mgmt_*；§6.1 布局决策）。可空：旧行无值（生成安装
  // 脚本前置校验非空）。 ----
  peerMgmtWsEndpoint        String? // worker 连 B 控制器的 WS 地址（B 须公网可达）
  peerMgmtArrangerPublicKey String? // B 控制器公钥（worker 验签 B 控制面）

  // ---- 限制配置（D7 全集；lower 成 SharedLimits，§7.1）----
  quotaMode               ShareQuotaMode @default(OneTime)
  quotaTrafficGb          Int? // null = 不限
  resetPeriodDays         Int?
  periodStartDate         DateTime?
  expireAt                DateTime?
  maxPorts                Int? // 端口数量上限，null = 不限
  portRangeStart          Int // 端口范围（安装时固化为该 service 监听区间）
  portRangeEnd            Int
  bandwidthLimitJson      String? // 类型化 JSON: ShareBandwidthLimitDto（复用端点共享类型）
  allowInboundProxy       Boolean        @default(true)
  allowedInboundProtocols String[]       @default([]) // 空 = 全部 7 种（语义同 OutboundEndpoint 同名列）
  allowForward            Boolean        @default(true) // 转发端点/链
  allowSpeedTest          Boolean        @default(false) // 共享机默认关：测速走裸 reqwest 出站、不计配额（D3），默认不放行防白嫖
  allowTenantLogs         Boolean        @default(true) // D10 一键开关
  allowTenantDebugExport  Boolean        @default(true)
  maxConnNum              Int?
  maxIpNum                Int?
  outboundPolicyJson      String? // 类型化 JSON: OutboundSharePolicy（复用端点共享类型）
  limitsRevision          BigInt         @default(0) // 单调递增，worker 对账（§7.2）
  // worker 经 SharedUsageReport 回带的**已生效** revision（控制器写入；#251）。
  // NULL = 从未上报过（未安装 / 非共享出口 / 老库）。周期补推据此去重：仅当它
  // != limitsRevision 才需要再推——HTTP 200 只代表控制器入队成功，不代表 worker 应用了。
  lastWorkerLimitsRevision BigInt?

  // ---- 核算（worker owner conn 第一手上报，max 合并；§7.5）----
  usedCumulativeRxHigh BigInt @default(0)
  usedCumulativeRxLow  BigInt @default(0)
  usedCumulativeTxHigh BigInt @default(0)
  usedCumulativeTxLow  BigInt @default(0)
  periodBaseHigh       BigInt @default(0) // 当期已用 = cumulative - periodBase
  periodBaseLow        BigInt @default(0)
  lastActivePorts      Int    @default(0)
  lastActiveConns      Int    @default(0)
  lastDeviceCount      Int    @default(0) // D2: A 只看设备计数

  note           String? // A 管理员备注，不同步 B
  // #336：删除请求时刻（软删）。非 NULL = 管理员已删除、UI 立即隐藏，但 worker 尚未回带
  // 确认终态 revision，行保留让 60s tick 继续补推；`lastWorkerLimitsRevision == limitsRevision`
  // 后由 tick 硬删（remove_line 级联）。NULL = 未请求删除（含全部存量行）。
  purgeRequestedAt DateTime?
  revokedAt      DateTime?
  releasedByPeer Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

// B 侧（Tenant）记录：邀请阶段 outboundEndpointId 为 null，
// S2S import 成功后创建服务器行并绑定（§4.3）。
model ImportedServerShare {
  id                 Int               @id @default(autoincrement())
  outboundEndpointId Int?              @unique
  outboundEndpoint   OutboundEndpoint? @relation(fields: [outboundEndpointId], references: [id], onDelete: SetNull)
  status             ServerShareStatus @default(PendingImport)
  displayName        String // B 创建邀请时的展示名（import 后作为服务器行初始名）
  // 创建邀请的 B 管理员 token_id：import 时把服务器行 push 进其 subscription.lines
  createdByTokenId   String?

  // ---- S2S 服务端材料（B 是被调方）----
  shareTokenHash         String  @unique // sha256(token)；import 成功后轮换
  previousShareTokenHash String? @unique // import 响应丢失时，同 peer 幂等重试可用的上一轮 token hash
  shareCodeUsedAt        DateTime?
  peerInstanceId         String? // A 面板实例 ID（幂等/防抢注）
  peerPanelName          String? // A 可选自报，允许匿名
  // B 创建邀请时填写：worker 接入 B 控制面的公网可达地址
  mgmtWsEndpoint   String
  minWorkerVersion String? // B 的最低 worker 版本要求（D9）

  // ---- 两阶段导入预留（#1 prepare 写 / confirm 晋升 / abort|sweep 清）----
  // 预留期间 status 仍是 PendingImport（码未消费、token 未轮换），单行天然互斥。
  // reservationNewTokenHash 是暂存值，confirm 时晋升进已 @unique 的 shareTokenHash，
  // 故此处**不**加 @unique（re-prepare 会覆写）。
  reservationInstanceId      String?
  reservationPubkey          String?
  reservationNewTokenHash    String?
  reservationLimitsJson      String? // 类型化 JSON: ServerShareLimitsDto
  reservationIngressIp       String?
  reservationPreparedAt      DateTime? // 预留时刻（lazy 覆盖 + sweep TTL 判定锚点）
  reservationPeerPanelName   String? // A 自报展示名（confirm 时晋升进 peerPanelName）
  reservationServerTimeOffsetMs BigInt? // A 时钟偏差（confirm 时晋升进 serverTimeOffsetMs）

  // ---- A 推送的快照（只读展示 + B 侧预校验镜像，ingest 时
  // PendingInstall→Active 映射，§3.2 三层 DTO）----
  limitsSnapshotJson String? // 类型化 JSON: ServerShareLimitsDto
  limitsRevision     BigInt         @default(0)
  usedTrafficHigh    BigInt         @default(0)
  usedTrafficLow     BigInt         @default(0)
  quotaMode          ShareQuotaMode @default(OneTime)
  quotaTrafficGb     Int?
  resetPeriodDays    Int?
  periodStartDate    DateTime?
  expireAt           DateTime?
  serverTimeOffsetMs BigInt? // A 时钟偏差（>5min UI 提示，沿用端点共享）
  lastPushAt         DateTime?
  workerOnline       Boolean        @default(false) // A push 回带（B 也有自己的第一手在线状态）
  workerVersion      String?
  // A（owner）上次 push 下发的机器入口 IP。用于「A 改 IP 自动同步」：仅当 B 侧
  // 服务器行 ingressIpv4 仍等于本值（即 B 未把它自定义成域名等）时，push 才自动
  // 替换成 A 的新 IP；否则保留 B 的自定义值。confirm 时初始化 = A 传来的 IP。
  ownerIngressIp     String?

  // A 侧动态 IP 开关与新鲜出口集合（S2S push 整列替换；B 侧 sweep 并入租界桶）。
  ownerDynamicIp     Boolean @default(false)
  // 类型化 JSON: Vec<ReportedEgressIp{ip,last_seen}>；last_seen = B 收到 push 的时间。
  ownerDynamicIpsJson String @default("[]")
  // 租界固化承载列：邀请创建时一次写入，confirm 复制到影子 OutboundEndpoint.tenantId。
  // null = 平台 / 未判定（存量解析链见 design §3.6）。
  tenantId           Int?
  tenant             Tenant? @relation(fields: [tenantId], references: [id])

  // ---- worker clamp 拒因快照（B 侧落库，阶段 3.6 / §7.3）----
  // worker tenant conn 每次 PortMap clamp 后上报 `SharedPortRejections` 全量快照，
  // B 控制器整体覆盖写入（类型化 JSON: Vec<SharedPortRejection>；空集 = 写 null）。
  // B 端口 UI 据此回显"被 A 限制拒绝"的端口与拒因（阶段 6）。
  portRejectionsJson String?
  portRejectionsAt   DateTime?

  releasedAt DateTime? // B 主动释放时间
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([tenantId])
}

model Port {
  id                        Int               @id @default(autoincrement())
  displayName               String
  portV4                    Int
  targetAddressV4           String
  targetPortV4              Int
  traffic_in                BigInt
  traffic_out               BigInt
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  lastEditedAt              DateTime?         // Last time port was edited via UI
  subscription              Subscription?     @relation(fields: [subscriptionId], references: [id])
  subscriptionId            Int?
  outboundEndpoint          OutboundEndpoint? @relation(fields: [outboundEndpointId], references: [id])
  outboundEndpointId        Int?
  forwardProtocol           String?
  forwardConfig             String?
  relatedForwardEndpointIds Int[]
  targetAddrList          String[]
  selectMode               Int?
  testMethod               Int?
  isSuspended              Boolean           @default(false)
  bandwidth                 Int?              // Port-specific bandwidth limit in Mbps
  upBandwidth               Int?              // Port-specific bandwidth limit in Mbps
  downBandwidth             Int?              // Port-specific bandwidth limit in Mbps
  bwLimitType               BwLimitType?           // BandWidht Limit type TotalUpAndDown(using bandwidth) or StandaloneUpAndDown(using upBandwidth and downBandwidth)
  dynamicBw                String? 
  acceptProxyProtocol       Boolean           @default(false) // Whether to accept PROXY protocol from client
  sendProxyProtocolVersion  Int?              // PROXY protocol version: null/0=disabled, 1=v1, 2=v2
  forwardMode               String?           // direct | relay | chain | tot; NULL = derive from legacy columns
  chainMode                 Boolean           @default(false) // chain mode
  forwardChainTestMethod Int? @default(0)
  forwardChainSmartSelect Boolean? @default(true)
  forwardChainFixedHopsNum  Int?
  forwardChainFixedLastHopsNum Int?
  // Per-port "network detailed planning" override layer (JSON of NetworkPlan).
  // Additive nullable: NULL = no override (base topology unchanged). Never
  // mutates the shared chain/group/endpoint definitions.
  networkPlan               String?

  relatedTotServerIds Int[]

  totServerTestMethod Int?
  totServerSelectMode Int?
  totSendMode         Int?
  // TOT 高级子流(链式/多端点优选)配置。JSON of Vec<TotSubStreamSpec>。
  // NULL/空 = 全部子流来自 relatedForwardEndpointIds(旧行为，每条子流 1 个转发端点)。
  // 这里的端点 id 不写入 relatedForwardEndpointIds(否则会被当成单端点子流展开)。
  totSubStreams       String?
  balanceStrategy   Int?
  inboundProxyConfig String?
  outboundProxyConfig String?   // JSON: OutboundProxyConfig; null = 直连（现状）
  // Inbound-proxy TLS certificate binding (e.g. AnyTLS). NULL for Manual-mode PEM or no TLS.
  // When the inboundProxyConfig JSON uses InboundTlsSource::Certificate { cert_id }, this
  // column must equal that cert_id so ssl_certificate_manage binding/delete protection sees it.
  inboundSslCertificateId Int?
  inboundSslCertificate   SslCertificate? @relation("PortInboundSslCert", fields: [inboundSslCertificateId], references: [id], onDelete: SetNull)
  customConfig       String?
  enableUdp          Boolean           @default(true) // Whether to enable UDP forwarding for this port
  syncedToWorkerAt   DateTime?         // Last time port was synced to worker (display only since rev gate)
  syncErrorMessage   String?           // Error message if sync to worker failed
  syncErrorAt        DateTime?         // When the sync error occurred
  configRev          Int               @default(0) // 配置代次：仅同步影响修改递增（设计 port-sync-failure-visibility §10.1）
  syncedRev          Int               @default(0) // 已被 worker 确认的代次：唯一写入点 = success writer（§10.3）

  // 分流规则集
  trafficRuleSetId   Int?
  trafficRuleSet     TrafficRuleSet?   @relation("PortTrafficRuleSet", fields: [trafficRuleSetId], references: [id], onDelete: SetNull)

  // 端口级入站防火墙规则集（附加闸门，仅 direction=INBOUND）
  inboundFirewallRuleSetId Int?
  inboundFirewallRuleSet   FirewallRuleSet? @relation("PortInboundFirewall", fields: [inboundFirewallRuleSetId], references: [id], onDelete: SetNull)

  tags               String[]          @default([])

  // 从聚合订阅链接(Clash/Surge/Shadowrocket 等)与 zf-client 节点发现接口中排除该端口对应的节点。
  // 仅对已开启入站代理(inboundProxyConfig 非空)的端口有意义；不影响该端口自身的单端口直链分享 URL。
  excludeFromSubscription Boolean       @default(false)

  // Port Suspend tracking
  suspendType             Int?      // 0=manual, 1=traffic_exceeded, 2=port_expired
  suspendedAt             DateTime?
  resumeAt                DateTime?  // auto-resume time

  // 单个转发目标定时暂停的最近恢复时刻 = min(直连行 `# pause until` ∪ networkPlan.disabled_until)。
  // 仅供控制器 port_target_resume 扫描器命中（WHERE targetResumeAt <= now）；派生自 targetAddrList/networkPlan，
  // **绝不**进 config hash / derived_key（否则自动恢复会无谓 churn 哈希）。NULL = 无定时暂停。
  targetResumeAt          DateTime?

  // Port Traffic Control
  periodTraffic           Int?      // GB limit (post-multiplier/scaled traffic)
  trafficResetPeriodDays  Int?      // reset cycle in days, null=no auto-resume
  periodStartDate         DateTime?
  // NOTE: periodUsedTraffic 为三套 high/low（合计 + 入向 + 出向），写/清/重置须三套同写。
  periodUsedTrafficHigh   BigInt?   // 合计 128-bit counter, high 64 bits (= in + out)
  periodUsedTrafficLow    BigInt?   // 合计 128-bit counter, low 64 bits
  periodUsedTrafficInHigh  BigInt?  // 入向(下行/download/traffic_in) high
  periodUsedTrafficInLow   BigInt?  // 入向 low
  periodUsedTrafficOutHigh BigInt?  // 出向(上行/upload/traffic_out) high
  periodUsedTrafficOutLow  BigInt?  // 出向 low
  periodTrafficLimitMode   PeriodTrafficLimitMode? // null = TotalInOut（默认）

  // Port Limits
  allowIpNum              Int?      // 端口级别最大来源IP数
  allowConnNum            Int?      // 端口级别每IP最大连接数
  expireAt                DateTime? // 端口到期时间，到期后自动暂停 suspend_type=2

  // 流量统计去 Redis（Phase 4）
  lastActiveAt            DateTime? // 替代 Redis port:last_active(60d)：端口最近有流量时刻
  statsClearedAt          DateTime? // 替代 cleared_at 水位 + clear cooldown 原子 claim(§8)

  @@index([portV4])
  @@index([expireAt])
  @@index([trafficRuleSetId])
  @@index([inboundFirewallRuleSetId])
  @@index([tags])
  @@index([subscriptionId])
  @@index([outboundEndpointId])
  @@index([outboundEndpointId, subscriptionId])
  // #536：同一服务器同一监听端口只能有一行。应用层只有 5s 不续期的 Redis 行锁 + worker netstat
  // 占用探测，挡不住并发建/改同号端口；以 DB 唯一约束为最终闸（撞约束 = P2002 → 「端口已被占用」）。
  // 存量重复由 migrate-hook 0004 在 db push 前预检并中止升级（不自动删用户端口）。
  @@unique([outboundEndpointId, portV4])
  @@index([outboundEndpointId, subscriptionId, portV4])
  @@index([isSuspended])
  @@index([periodTraffic])
  @@index([inboundSslCertificateId])
  @@index([targetResumeAt])
}

// 流量统计去 Redis：批次去重权威表（Phase 5 起为唯一去重真源，flush 时实时查询；无进程内 seen 窗口）。
// 不变量2：flush 中本表 INSERT 与计数 UPDATE 在**同一事务**原子提交 ⇒ 增量被计入 ⟺ batchId 入本表
// ⇒ over-count 结构上不可能（重发被 INSERT ON CONFLICT / 窗口内折叠拦下）。3d 窗口由 expiresAtMs GC。
model ProcessedTrafficBatch {
  batchId       String @id // UUID v4
  kind          Int        // 0=Port 1=ForwardEndpoint(TrafficBatchKind)；#470 隔离尝试的合成身份也写 0（列只写不读）
  processedAtMs BigInt
  expiresAtMs   BigInt

  @@index([expiresAtMs])
}

