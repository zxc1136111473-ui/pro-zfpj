// 解锁脚本类型枚举
enum UnlockScriptType {
  PYTHON
  BASH
}

// ========== 分流管理系统 ==========

enum TrafficMatchType {
  DOMAIN_EXACT      // 精确域名匹配
  DOMAIN_SUFFIX     // 域名后缀匹配
  DOMAIN_KEYWORD    // 域名关键词匹配
  DOMAIN_REGEX      // 域名正则匹配
  IP_CIDR           // IP/CIDR匹配
  GEOIP             // GeoIP国家/地区匹配
  COMPOSITE         // 组合匹配（支持AND/OR/NOT逻辑）
  RULE_FILE         // 导入规则文件
  // 来源匹配类型
  SOURCE_IP_CIDR    // 来源IP CIDR匹配
  SOURCE_PORT       // 来源端口精确匹配
  SOURCE_PORT_RANGE // 来源端口范围匹配
  SOURCE_GEOIP      // 来源地理位置匹配
  // 协议匹配
  PROTOCOL          // 协议匹配（TCP/UDP）
  // 目标端口匹配
  DESTINATION_PORT       // 目标端口精确匹配
  DESTINATION_PORT_RANGE // 目标端口范围匹配
  // ASN匹配
  ASN                    // ASN自治系统号匹配（目标IP）
  SOURCE_ASN             // 来源ASN自治系统号匹配
}

enum RuleFileType {
  CLASH            // Clash规则格式
  SURGE            // Surge规则格式
  QUANTUMULT_X     // Quantumult X规则格式
  CUSTOM           // 自定义格式
}

enum DefaultAction {
  AUTO              // 自动（跟随默认策略）
  REJECT            // 拒绝
  USE_SELECTOR      // 使用指定选择器
}

model TrafficMatchRule {
  id               Int      @id @default(autoincrement())
  name             String   @unique          // 规则名称（唯一标识）
  displayName      String                    // 显示名称
  description      String?                   // 规则描述

  // 匹配类型和内容
  matchType        TrafficMatchType          // 匹配类型
  matchContent     String   @db.Text         // 匹配内容（JSON格式，存储具体匹配规则）

  // 导入的规则文件
  ruleFileUrl      String?                   // 外部规则文件URL
  ruleFileContent  String?  @db.Text         // 规则文件内容缓存
  ruleFileType     RuleFileType?             // 规则文件类型（Clash、Surge等）
  ruleFileUpdatedAt DateTime?                // 规则文件最后更新时间

  // 权限控制
  isPublic         Boolean  @default(false)  // 是否公开（所有用户可用）
  ownerId          Int?                      // 所有者订阅ID（私有规则）
  owner            Subscription? @relation("TrafficMatchRuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 启用状态
  isEnabled        Boolean  @default(true)

  // 使用统计
  usageCount       Int      @default(0)      // 被引用次数

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 关联的分流规则
  trafficRules     TrafficRule[]

  // 关联的防火墙规则（reuse of TrafficMatchRule for source-side matching)
  firewallRules    FirewallRule[]

  // 多租户：所属租户（null=平台）。ownerId 语义不变（创建者账号）。
  tenantId         Int?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([isPublic])
  @@index([isEnabled])
  @@index([matchType])
  @@index([name])
  @@index([tenantId])
}

model TrafficOutboundSelector {
  id               Int      @id @default(autoincrement())
  name             String   @unique          // 选择器名称
  displayName      String                    // 显示名称
  description      String?                   // 描述

  // 选择策略（有序，支持fallback）
  selectorChain    String   @db.Text         // JSON数组，存储选择器链

  // 权限控制
  isPublic         Boolean  @default(false)
  ownerId          Int?
  owner            Subscription? @relation("TrafficOutboundSelectorOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 启用状态
  isEnabled        Boolean  @default(true)

  // 使用统计
  usageCount       Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 关联的分流规则
  trafficRules     TrafficRule[]

  // 作为默认选择器的规则集
  defaultForRuleSets TrafficRuleSet[]

  // 多租户：所属租户（null=平台）
  tenantId         Int?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([isPublic])
  @@index([isEnabled])
  @@index([name])
  @@index([tenantId])
}

model TrafficRule {
  id                        Int      @id @default(autoincrement())
  name                      String   @unique
  displayName               String
  description               String?

  // 关联匹配规则和出口选择器
  matchRuleId               Int
  matchRule                 TrafficMatchRule @relation(fields: [matchRuleId], references: [id], onDelete: Cascade)

  outboundSelectorId        Int
  outboundSelector          TrafficOutboundSelector @relation(fields: [outboundSelectorId], references: [id], onDelete: Cascade)

  // 权限控制
  isPublic                  Boolean  @default(false)
  ownerId                   Int?
  owner                     Subscription? @relation("TrafficRuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 启用状态
  isEnabled                 Boolean  @default(true)

  // 使用统计
  usageCount                Int      @default(0)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // 关联的规则集
  ruleSetRules              TrafficRuleSetRule[]

  // 多租户：所属租户（null=平台）
  tenantId                  Int?
  tenant                    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([matchRuleId])
  @@index([outboundSelectorId])
  @@index([ownerId])
  @@index([isPublic])
  @@index([isEnabled])
  @@index([name])
  @@index([tenantId])
}

model TrafficRuleSet {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  displayName       String
  description       String?

  // 权限控制
  isPublic          Boolean  @default(false)
  ownerId           Int?
  owner             Subscription? @relation("TrafficRuleSetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 启用状态
  isEnabled         Boolean  @default(true)

  // 默认行为（当所有规则都不匹配时）
  defaultAction     DefaultAction @default(AUTO)
  defaultSelectorId Int?  // 当defaultAction=USE_SELECTOR时使用
  defaultSelector   TrafficOutboundSelector? @relation(fields: [defaultSelectorId], references: [id], onDelete: SetNull)

  // 使用统计
  usageCount        Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 关联的规则（多对多）
  ruleSetRules      TrafficRuleSetRule[]

  // 被哪些端口使用
  ports             Port[]   @relation("PortTrafficRuleSet")

  // 多租户：所属租户（null=平台）
  tenantId          Int?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([isPublic])
  @@index([isEnabled])
  @@index([name])
  @@index([tenantId])
}

model TrafficRuleSetRule {
  id            Int      @id @default(autoincrement())
  ruleSetId     Int
  ruleSet       TrafficRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  ruleId        Int
  rule          TrafficRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // 规则优先级（数字越小优先级越高）
  priority      Int      @default(0)

  createdAt     DateTime @default(now())

  @@unique([ruleSetId, ruleId])
  @@unique([ruleSetId, priority])
  @@index([ruleSetId])
  @@index([ruleId])
  @@index([priority])
}

// ========== Firewall (server-inbound-firewall-design rev 4) ==========

enum FirewallAction {
  ALLOW
  REJECT
}

enum FirewallDirection {
  INBOUND
  OUTBOUND
}

model FirewallRule {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  displayName   String
  description   String?

  // Reuse TrafficMatchRule for the match condition shape — same UI, same
  // Clash/Surge import path, same usage counters. Restrict so we don't
  // silently delete a match rule that a firewall still references.
  matchRuleId   Int
  matchRule     TrafficMatchRule @relation(fields: [matchRuleId], references: [id], onDelete: Restrict)

  action        FirewallAction
  // Lower = earlier evaluation. Mirrors RoutingRule.priority semantics.
  priority      Int      @default(100)

  isPublic      Boolean  @default(false)
  ownerId       Int?
  owner         Subscription? @relation("FirewallRuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  isEnabled     Boolean  @default(true)
  usageCount    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleSetRules  FirewallRuleSetRule[]

  // 多租户：所属租户（null=平台）
  tenantId      Int?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([matchRuleId])
  @@index([ownerId])
  @@index([isPublic])
  @@index([action])
  @@index([tenantId])
}

model FirewallRuleSet {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  displayName   String
  description   String?

  direction     FirewallDirection
  // Falls through here when no rule matches. ALLOW = no-op on empty,
  // REJECT = deny-all on empty (load-bearing — see design §5.1.1).
  defaultAction FirewallAction    @default(ALLOW)

  isPublic      Boolean  @default(false)
  ownerId       Int?
  owner         Subscription? @relation("FirewallRuleSetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  isEnabled     Boolean  @default(true)

  // Honeypot probe capture (INBOUND rule sets only). When enabled, a connection
  // REJECTED by this rule set is NOT dropped immediately — the worker holds the
  // socket, captures up to `probeCaptureMaxBytes` of what the peer sends plus the
  // connection duration, then closes. By default it closes as soon as it has the
  // bytes / the peer EOFs; `probeCaptureLingerEnabled` makes it hold the conn
  // (reading+discarding) until the peer disconnects or `probeCaptureMaxDurationSecs`
  // (resource guard / tarpit duration). Default off.
  probeCaptureEnabled         Boolean @default(false)
  probeCaptureMaxBytes        Int     @default(4096)
  probeCaptureMaxDurationSecs Int     @default(60)
  probeCaptureLingerEnabled   Boolean @default(false)

  usageCount    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleSetRules      FirewallRuleSetRule[]

  inboundOnServers  OutboundEndpoint[] @relation("ServerInboundFirewall")
  outboundOnServers OutboundEndpoint[] @relation("ServerOutboundFirewall")
  inboundOnPorts    Port[]             @relation("PortInboundFirewall")
  inboundOnForwarders ForwardEndpoint[] @relation("ForwarderInboundFirewall")
  subFetchSubscriptions Subscription[] @relation("SubFetchFirewall")
  defaultInboundOnPackages Package[] @relation("PackageDefaultInboundFirewall")
  defaultInboundOnSubscriptions Subscription[] @relation("SubscriptionDefaultInboundFirewall")

  // 多租户：所属租户（null=平台）
  tenantId      Int?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([direction])
  @@index([ownerId])
  @@index([isPublic])
  @@index([isEnabled])
  @@index([name])
  @@index([tenantId])
}

model FirewallRuleSetRule {
  id          Int @id @default(autoincrement())
  ruleSetId   Int
  ruleSet     FirewallRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  ruleId      Int
  rule        FirewallRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Per-membership priority override. NULL → use FirewallRule.priority.
  priority    Int?

  createdAt   DateTime @default(now())

  @@unique([ruleSetId, ruleId])
  @@index([ruleSetId])
  @@index([ruleId])
  @@index([priority])
}

// ========== 公告系统 ==========

enum AnnouncementContentType {
  MARKDOWN
  HTML
}

model Announcement {
  id              Int                     @id @default(autoincrement())
  title           String                  // 公告标题
  content         String                  @db.Text // 公告内容
  contentType     AnnouncementContentType // 内容格式类型

  isVisible       Boolean                 @default(true) // 是否用户可见
  isPinned        Boolean                 @default(false) // 是否置顶
  sortOrder       Int                     @default(0) // 排序顺序(数字越小越靠前)

  // 有效期控制
  effectiveAt     DateTime                @default(now()) // 生效时间
  expiresAt       DateTime?               // 过期时间(null表示永不过期)

  // 创建信息
  createdBy       Int?                    // 创建者(管理员订阅ID)

  // 多租户：null=平台公告；非 null 仅本租户用户可见
  tenantId        Int?
  tenant          Tenant?                 @relation(fields: [tenantId], references: [id])
  // 仅平台公告(tenantId=null)有意义：true=下发到各租户用户；false=仅平台侧用户可见。
  // 租户公告忽略此字段。默认 true 兼容历史 D1「平台公告全员可见」。
  broadcastToTenants Boolean              @default(true)

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([isVisible])
  @@index([isPinned, sortOrder])
  @@index([effectiveAt])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("announcements")
}

// ========== API Key 管理 ==========

model ApiKey {
  id              Int       @id @default(autoincrement())
  name            String    // API Key 名称/描述
  description     String?   // 可选的详细描述
  keyHash         String    @unique // SHA-256 hash of the full key
  keyPrefix       String    // First 16 chars for UI display
  prefix          String    @default("zfk") // User-customizable prefix
  keyRaw          String    @default("") // Stores full API key for later retrieval
  createdByTokenId String   // The admin token_id who created this key
  scopes          String[]  @default([]) // Granted ApiKeyScope values (snake_case). Empty = deny-all; ["full"] = wildcard. See zf-web auth::scope.
  isActive        Boolean   @default(true)
  expiresAt       DateTime? // Optional expiration
  lastUsedAt      DateTime? // Track last usage
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([keyHash])
  @@index([createdByTokenId])
  @@index([isActive])
}

// ========== Operation Audit Log ==========

enum SslCertSource {
  MANUAL
  LETSENCRYPT
}

enum SslCertStatus {
  ACTIVE
  EXPIRED
  PENDING
  FAILED
  REVOKED
}

model SslCertificate {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  source          SslCertSource
  status          SslCertStatus   @default(PENDING)

  certPem         String?         // Full chain PEM (null while PENDING)
  keyPem          String?         // Private key PEM

  // Auto-extracted metadata
  domains         String[]
  issuer          String?
  certType        String?         // "RSA", "ECDSA"
  keyBits         Int?
  notBefore       DateTime?
  notAfter        DateTime?
  serialNumber    String?
  certHash        String?         // SHA256 fingerprint of leaf cert DER

  // ACME fields (LETSENCRYPT only)
  dnsConfigId     Int?
  dnsConfig       DnsApiConfig?   @relation(fields: [dnsConfigId], references: [id])
  dnsZoneId       String?
  autoRenew       Boolean         @default(true)
  lastRenewalAt   DateTime?
  renewalError    String?
  lastAttemptAt   DateTime?       // When last issue/renew was attempted

  // Relation
  forwardEndpoints ForwardEndpoint[]
  inboundPorts     Port[]          @relation("PortInboundSslCert")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([source])
  @@index([notAfter])
}

model AcmeAccount {
  id              Int             @id @default(autoincrement())
  email           String
  credentialsJson String          @map("accountKeyPem") // ACME account credentials (instant_acme serialized)
  accountUrl      String?
  directoryUrl    String          // "https://acme-v02.api.letsencrypt.org/directory" or staging
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive])
}

enum AuditAction {
  Create
  Update
  Delete
  Suspend
  Resume
  BatchCreate
  BatchUpdate
  BatchDelete
  Extend
  Switch
  RefreshToken
  PaymentCallback
  // agent-exec：AI 调试 agent 在 worker/forwarder 实例上执行一次性 shell 命令。
  Execute
  // agent-exec：读类操作（如枚举 worker/forwarder 实例清单 = fleet inventory 发现）。
  Read
  // RBAC：给管理员挂/摘角色。
  Assign
  // RBAC：子管理员越权被拒（403）。
  AccessDenied
  // 面板登录会话：登录成功/失败审计。
  Login
  // 面板登录会话：撤销会话（自助踢设备 / 管理端踢 / 级联）。
  RevokeSession
  // 超管应急通道（N2 例外）：取用租户管理员 token。罕见事件，每次调用独立成行，
  // 禁止与任何其它行合并/去重——这行本身就是该通道唯一的问责证据。
  EmergencyAccess
}

enum AuditResourceType {
  Port
  OutboundEndpoint
  ServerGroup
  ForwardEndpoint
  ForwarderEndpointGroup
  Subscription
  Package
  ForwardChain
  SslCertificate
  AcmeAccount
  Payment
  AdminRole
  Tenant
  Session
  RedeemCode
  Order
  Announcement
  Ticket
  Referral
  /// 租户通知策略（TenantNotificationPolicy），勿借用 Subscription。
  NotificationPolicy
}

enum AuditOutcome {
  Success
  Failed
  Warning
  /// 两阶段审计 attempt 态（C14）：已发起、终态未知。不可复用 NULL——NULL 是默认值/历史未标注。
  Pending
}

model AuditLog {
  id              Int               @id @default(autoincrement())
  actor           String
  actorName       String?
  subscriptionId  Int?
  action          AuditAction
  resourceType    AuditResourceType
  resourceId      Int?
  resourceName    String?
  description     String
  requestBody     String?           @db.Text
  affectedCount   Int?
  relatedIds      String?
  outcome         AuditOutcome?
  /// 目标资源所属租户的**快照**（null = 平台资源）。资源删除后仍可追溯归属。无 FK。
  tenantId        Int?
  createdAt       DateTime          @default(now())

  @@index([actor])
  @@index([subscriptionId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@index([outcome])
  @@index([tenantId])
}

// ==================== RBAC 管理员角色 ====================

// 自定义管理员角色：permissions 存 wire 串（如 "servers:read"），语义见 zf-web auth/perm.rs。
// 超管仍由 Subscription.isAdmin 标识（全权限，不走角色）；红线权限不在 wire 枚举内，天然配不出。
model AdminRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("")
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments AdminRoleAssignment[]
}

model AdminRoleAssignment {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  roleId         Int
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  role           AdminRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, roleId])
  @@index([subscriptionId])
  @@index([roleId])
}

// ==================== 推广返利系统 ====================

model ReferralRelationship {
  id              Int          @id @default(autoincrement())
  referrerId      Int          // 邀请者 subscription.id
  referredId      Int          @unique // 被邀请者（唯一，保证单层）
  referralCode    String       // 使用的推广码快照
  registrationIp  String?      // 被邀请者注册 IP
  commissionCount Int          @default(0) // 已产生有效佣金次数（终身累计，跨换绑/清除不重置）
  isActive        Boolean      @default(true) // false = 管理员已清除推荐关系，保留行承载 commission_count 终身额度
  createdAt       DateTime     @default(now())

  referrer        Subscription @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        Subscription @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCode])
  @@index([registrationIp])
  @@index([isActive])
}

// 推广成分：可为不同推广人配置差异化的佣金类型/值/次数上限
model ReferralCommissionComponent {
  id                 Int            @id @default(autoincrement())
  name               String         @unique // 管理员可读标识
  commissionType     String         // "FIXED" | "PERCENTAGE"
  commissionValue    Int            // FIXED=分，PERCENTAGE=基点
  maxCommissionCount Int            // 每被邀请人最多产生佣金的充值次数
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subscriptions      Subscription[] @relation("SubscriptionCommissionComponent")

  @@index([name])
}

enum ReferralCommissionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REVERSED       // 已确认佣金被管理员回滚
}

model ReferralCommission {
  id               Int                      @id @default(autoincrement())
  referrerId       Int                      // 获佣者（冗余便于查询）
  referredId       Int                      // 充值者
  orderId          Int          @unique     // 触发佣金的充值订单 —— 唯一约束，保证幂等
  orderAmount      Int                      // 订单实付金额快照（分）
  commissionAmount Int                      // 佣金金额（分）
  commissionType   String                   // "FIXED" / "PERCENTAGE"（快照）
  commissionValue  Int                      // 快照：固定分值 或 百分比基点
  status           ReferralCommissionStatus @default(PENDING)
  confirmAt        DateTime                 // 预计确认时间
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  reversedDeficit  Int?                     // 回滚时未追回的差额（分），非 null 表示部分回滚
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  referrer         Subscription @relation("CommissionEarner", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
  @@index([referredId])
  @@index([status, confirmAt])
}

enum ReferralTransactionType {
  COMMISSION_CONFIRMED   // 佣金确认到账
  COMMISSION_REVERSED    // 已确认佣金被回滚（扣款）
  TRANSFER_TO_BALANCE    // 转入主余额
  WITHDRAWAL_REQUEST     // 提现申请（扣款）
  WITHDRAWAL_APPROVED    // 提现完成
  WITHDRAWAL_REJECTED    // 提现拒绝（退回）
  ADMIN_ADJUSTMENT       // 管理员手动调整
}

model ReferralTransaction {
  id              Int                     @id @default(autoincrement())
  subscriptionId  Int
  type            ReferralTransactionType
  amount          Int                     // 正数=入账，负数=扣款（分）
  balanceBefore   Int                     // 变动前余额
  balanceAfter    Int                     // 变动后余额
  relatedId       Int?                    // 关联 ReferralCommission.id 或 Ticket.id
  note            String?
  createdAt       DateTime                @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([type])
}

enum ReferralWithdrawalStatus {
  PENDING    // 用户提交，待管理员处理
  APPROVED   // 管理员已批准
  REJECTED   // 管理员已拒绝（余额退回）
}

model ReferralWithdrawal {
  id              Int                       @id @default(autoincrement())
  subscriptionId  Int
  amount          Int                       // 提现金额（分）
  status          ReferralWithdrawalStatus  @default(PENDING)
  adminNote       String?                   // 管理员备注
  processedAt     DateTime?                 // 处理时间
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  // 提交时收款账户的快照（账户表后续删改不影响历史 / 审核）
  accountType     WithdrawalAccountType?
  accountName     String?
  accountNumber   String?
  bankName        String?

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

enum WithdrawalAccountType {
  BANK
  WECHAT
  ALIPAY
}

// 用户保存的收款账户：每个 subscription 每种类型最多一条
model WithdrawalAccount {
  id             Int                   @id @default(autoincrement())
  subscriptionId Int
  accountType    WithdrawalAccountType
  accountName    String                // 收款人姓名
  accountNumber  String                // 银行卡号 / 微信号 / 支付宝账号
  bankName       String?               // 仅 BANK 使用
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, accountType])
  @@index([subscriptionId])
}

// =========================================================================
// Admin KPI Dashboard snapshot tables
// 仅追加，不改老表。由 zf-web::dashboard_rollup_service 定时写入。
// =========================================================================

// ⚠️ Legacy（#595）：分钟级时序快照。读路径已全部迁到 ServerStatusCurrent
// （概览只需要"最近状态 + 最后在线时间"，31 天分钟行无人消费）。
// 新代码不再读写本表；0005 hook 回填、0006 hook 清空存量行，表本身待后续版本摘除 model
// 时由 db push 删除。不要新增读点。
model ServerStatusSnapshot {
  id            Int      @id @default(autoincrement())
  serverId      Int      // OutboundEndpoint.id 弱引用，不加 FK 避免级联
  bucketAt      DateTime // 对齐到分钟
  isOnline      Boolean  // Redis server:status:{id} == 1
  cpuUsage      Float?   // 从 system_stats:{id} 读
  memoryUsedPct Float?
  diskUsedPct   Float?   // 从 system_stats:{id} 的 disk_used / disk_total 计算
  rxBps         BigInt?  // 从 netcard_speed:{id} 读
  txBps         BigInt?
  createdAt     DateTime @default(now())

  @@unique([serverId, bucketAt])
  @@index([bucketAt])
}

// 服务器当前状态（每台一行，60s UPSERT 覆盖；serverId 既是主键也是幂等键）。
// `observedAt` = 最近一次成功采样时间：读侧 >5min 视为"状态过期/未知"，而不是离线
// （Redis / 采集失败不得制造离线事实）。`lastOnlineAt` 只在上报在线时刷新，离线保留
// 原值，供"离线多久 / 从未在线"展示。
model ServerStatusCurrent {
  serverId      Int       @id // OutboundEndpoint.id 弱引用，不加 FK 避免级联
  isOnline      Boolean // Redis server:status:{id} == 1
  cpuUsage      Float? // 从 system_stats:{id} 读
  memoryUsedPct Float?
  diskUsedPct   Float? // 从 system_stats:{id} 的 disk_used / disk_total 计算
  rxBps         BigInt? // 从 netcard_speed:{id} 读
  txBps         BigInt?
  observedAt    DateTime // 最近一次成功采样时间
  lastOnlineAt  DateTime? // 最近一次观测到在线的时间；离线时保留原值
  updatedAt     DateTime @updatedAt
}

// 日活订阅（UTC 日，每 10min 滚动 UPSERT）
model DailyActiveSubscription {
  id          Int      @id @default(autoincrement())
  day         DateTime // UTC 00:00
  activeCount Int      // 当日有流量增量的 subscriptionId 去重数
  totalCount  Int      // 当日末时刻 activated=true 且 !isAdmin
  newCount    Int      // 当日新增订阅
  updatedAt   DateTime @updatedAt

  @@unique([day])
  @@index([day])
}

// 收入日聚合（UTC 日，每 10min 滚动 UPSERT；口径见 plan §3.1）
model DailyRevenueSnapshot {
  id           Int      @id @default(autoincrement())
  day          DateTime // UTC 00:00
  currency     String   @default("CNY")
  orderCount   Int      // 只计正向销售订单数
  grossAmount  BigInt   // 分：正向销售合计
  refundAmount BigInt   @default(0) // 分：BALANCE_REFUND 取绝对值合计
  netAmount    BigInt   // gross - refund
  updatedAt    DateTime @updatedAt

  @@unique([day, currency])
  @@index([day])
}

// 流量日聚合（UTC 日，每 1h 滚动 UPSERT）
// user_line_info 只有 traffic_inc + upload_speed/download_speed，无字节上下行区分
model DailyTrafficSnapshot {
  id                 Int      @id @default(autoincrement())
  day                DateTime // UTC 00:00
  totalByte          BigInt   // SUM(traffic_inc) 全站当日累计
  peakUploadBps      BigInt?  // MAX(upload_speed)
  peakDownloadBps    BigInt?  // MAX(download_speed)
  avgUploadBps       BigInt?  // AVG(upload_speed)
  avgDownloadBps     BigInt?  // AVG(download_speed)
  updatedAt          DateTime @updatedAt

  @@unique([day])
  @@index([day])
}

// =========================================================================
// ZFC schema release ledger
// 由 install.sh 在 schema 迁移临界区维护；zf-web / zf-controler 启动时校验。
// =========================================================================

model ZfcSchemaState {
  id                     Int      @id
  status                 String
  releaseVersion         String
  schemaArtifactSha256   String
  zfWebImageDigest       String?
  zfControlerImageDigest String?
  operationId            String?
  appliedAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ZfcSchemaHook {
  id        String   @id
  checksum  String
  appliedAt DateTime @default(now())
}

// ===========================================================================
// 订阅链接自动生成与管理（多平台订阅：Clash/Surge/Shadowrocket）
// 命名：Subscription=账户(既有)；SubscriptionTemplate=配置模板；SubscriptionLink=订阅链接
// ===========================================================================

model SubscriptionTemplate {
  id          Int      @id @default(autoincrement())
  ownerId     Int?     // → Subscription.id；null = 内置/系统
  owner       Subscription? @relation("SubTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String   @unique  // 系统生成稳定唯一键（builtin:standard-routing / {ownerId}:{slug}）
  displayName String            // 用户可见名
  isBuiltin   Boolean  @default(false) // 系统种子模板（克隆即用）
  isPublic    Boolean  @default(false) // 管理员公开给所有订阅用户
  isEnabled   Boolean  @default(true)
  configJson  String   @db.Text        // 序列化 SubTemplateConfig（5 大组件）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId])
  @@index([isPublic])
}

model SubscriptionLink {
  id                    Int      @id @default(autoincrement())
  ownerId               Int      // → Subscription.id（必填，账户级流量归属）
  owner                 Subscription @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  tokenHash             String   @unique   // 生产 token SHA-256（校验用；查找仍走 hash）
  tokenPlain            String?            // 明文生产 token 冗余存储，用于「随时查看链接/二维码」按需回显；
                                            // 本功能上线前创建的链接此列为 null，需重置一次 Token 才能启用。
                                            // 有意降低的安全边界——已有「重置 Token」兜底，产品侧已确认可接受。
  previousTokenHash     String?            // 仅在途请求宽限；默认 rotate 即刻失效(grace=0 不写)
  previousTokenExpireAt DateTime?          // 旧 token 宽限到期；查找仅当 now<此值才接受 previous
  previewTokenHash      String?  @unique   // 独立调试/预览 token（可单独重置）
  previewExpireAt       DateTime?          // 预览 token 可选短 TTL（null=不过期）
  snapshotJson          String   @db.Text  // 冻结的 SubTemplateConfig，与源模板脱钩
  sourceTemplateId      Int?               // 仅溯源（克隆自哪个模板），不参与规则解析
  allowedFormats        String[]           // 限定可导出格式；空=全部(clash/surge/shadowrocket)
  isEnabled             Boolean  @default(true)
  fetchCount            Int      @default(0)   // 生产拉取审计计数（预览不计）
  lastFetchedAt         DateTime?
  lastFetchIp           String?
  lastFetchUa           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  fetchLogs             SubLinkFetchLog[]
  @@index([ownerId])
  @@index([sourceTemplateId])
}

/// 订阅链接拉取审计事件（G1）：60s 固定桶原子 upsert，双上限清理（90 天 + 每 link 2000 条）。
model SubLinkFetchLog {
  id          Int              @id @default(autoincrement())
  linkId      Int
  link        SubscriptionLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ownerId     Int
  owner       Subscription     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  windowStart DateTime
  fetchedAt   DateTime
  ip          String
  userAgent   String
  uaHash      String
  tokenKind   Int              // 0=当前生产 1=宽限旧token 2=预览
  fetchCount  Int              @default(1)
  geo         String?
  @@unique([linkId, ip, uaHash, tokenKind, windowStart])
  @@index([linkId, fetchedAt])
  @@index([ownerId, fetchedAt])
  @@index([fetchedAt], map: "sub_link_fetch_log_fetched_idx") // cleanup scan only
}

// G2 账户级踢 IP：canonical 前缀键（v4 /32；v6 /64|/128），upsert 按 (subscriptionId, ipPrefix)。
// 活跃条件：revokedAt IS NULL AND expiresAt > DB now()。
model KickedIp {
  id               Int          @id @default(autoincrement())
  subscriptionId   Int
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  ipPrefix         String       // canonical：v4 /32；v6 /64|/128
  createdAt        DateTime     @default(now())
  lastKickedAt     DateTime     @default(now()) // re-kick 更新；UI 历史语义用此
  expiresAt        DateTime     // clamp ≤ now+30d（DB 时间）
  reason           String?      // 长度上限（如 ≤200 字符）
  createdByTokenId String?      // 操作者 token_id（对齐 audit_log_service 先例）
  revokedAt        DateTime?
  @@unique([subscriptionId, ipPrefix])
  @@index([subscriptionId, expiresAt])
}

// ========== 多租户（Multi-Tenant，license feature） ==========
// 面板内多租户：租户是能正常运营面板的实体（管自己的服务器/转发端点/用户/套餐）。
// 注意与跨面板共享的"面板B租户"（ServerShare/ImportedServerShare）是两个概念，互不相干。
// 一租户一管理账号：Subscription.isTenantAdmin 只在"创建租户"事务中置 true，全库无其他写点。
// Tenant 无出边 FK（面板迁移拓扑排序不成环）；所有归属列均为可空单向 FK 指向本表。

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id          Int          @id @default(autoincrement())
  name        String       @unique          // 租户名（展示用）
  status      TenantStatus @default(ACTIVE)
  note        String       @default("")     // 超管备注

  // 配额（null = 不限）
  maxServers  Int?
  maxUsers    Int?                           // 只计终端用户，不含租户管理员自身
  maxPorts    Int?
  // 五域租户化新增配额（null=不限，照抄 maxServers 形态；tenant-admin-domain-expansion §4.3）
  maxWgNetworks         Int?
  maxNatTraversals      Int?
  maxForwardChains      Int?
  maxUnlockServices     Int?
  maxMatchRules         Int?
  maxTrafficRules       Int?
  maxTrafficRuleSets    Int?
  maxOutboundSelectors  Int?
  maxFirewallRules      Int?
  maxFirewallRuleSets   Int?
  /// 是否允许租户管理员分发（建订阅账户/套餐/兑换码）。默认关，超管显式开启。
  allowDistribution Boolean @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions     Subscription[]
  outboundEndpoints OutboundEndpoint[]
  forwardEndpoints  ForwardEndpoint[]
  importedServerShares ImportedServerShare[]
  packages          Package[]
  orders            Order[]
  redeemCodes       RedeemCode[]
  announcements     Announcement[]
  serverGroups      ServerGroup[]
  forwarderGroups   ForwarderEndpointGroup[]
  // 五域租户化：十张新资源表反向关系（onDelete Restrict 在资源侧）
  forwardChains            ForwardChain[]
  natTraversals            NatTraversal[]
  wgNetworks               WgNetwork[]
  trafficMatchRules        TrafficMatchRule[]
  trafficOutboundSelectors TrafficOutboundSelector[]
  trafficRules             TrafficRule[]
  trafficRuleSets          TrafficRuleSet[]
  firewallRules            FirewallRule[]
  firewallRuleSets         FirewallRuleSet[]
  unlockServiceConfigs     UnlockServiceConfig[]
  notificationPolicies     TenantNotificationPolicy[]

  @@index([status])
}

// per-tenant 通知策略（运维告警 + 生命周期）；tenant-admin-domain-expansion §4.4
enum NotificationPolicySource {
  Lifecycle   // NotificationKind:发给事件所属租户用户
  OpsAlert    // AlertReason:推给租户管理员
}

model TenantNotificationPolicy {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source    NotificationPolicySource
  kind      Int      // source=Lifecycle → NotificationKind 整数映射
                     // source=OpsAlert  → AlertReason 整数映射
  enabled   Boolean
  channels  Int      // bitflags EMAIL=1 | TELEGRAM=2（与 NotificationSetting 同义）
  thresholds String? // JSON，按 kind 解释
  updatedAt DateTime @updatedAt

  @@unique([tenantId, source, kind])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// DDNS (S3a) — claim 层 + 绑定；见 docs/design/dynamic-ingress-notify-and-ddns.md §5.2.2
// ---------------------------------------------------------------------------

enum DdnsFamilyFilter {
  V4Only
  V6Only
  Both
}

enum DdnsResourceType {
  Server
  ForwardEndpoint
}

enum DnsRecordKind {
  A
  AAAA
}

enum DnsClaimOwner {
  Ddns
  GroupAutoSwitch
}

enum DdnsErrorKind {
  Config
  Transient
  RateLimited
  Stale
}

model DdnsBinding {
  id             Int              @id @default(autoincrement())
  resourceType   DdnsResourceType
  resourceId     Int
  dnsApiConfigId Int
  dnsApiConfig   DnsApiConfig     @relation(fields: [dnsApiConfigId], references: [id])
  zoneId         String
  recordName     String           // 用户原样输入
  canonicalName  String           // 小写 + 去末尾点 + IDNA
  family         DdnsFamilyFilter @default(Both)
  ttl            Int              @default(60)
  proxied        Boolean          @default(false)
  enabled        Boolean          @default(true)
  observeOnly    Boolean          @default(true)
  description    String?
  claims         DnsRecordClaim[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([resourceType, resourceId])
  @@index([enabled])
}

model DnsRecordClaim {
  id                  Int            @id @default(autoincrement())
  providerAuthority   String
  zoneId              String
  canonicalName       String
  recordType          DnsRecordKind
  owner               DnsClaimOwner
  ddnsBindingId       Int?
  ddnsBinding         DdnsBinding?   @relation(fields: [ddnsBindingId], references: [id], onDelete: Cascade)
  serverGroupId       Int?
  serverGroup         ServerGroup?   @relation(fields: [serverGroupId], references: [id], onDelete: Cascade)
  dnsApiConfigId      Int
  dnsApiConfig        DnsApiConfig   @relation(fields: [dnsApiConfigId], references: [id])

  appliedFp           String?
  providerRecordId    String?
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  lastErrorKind       DdnsErrorKind?
  consecutiveFailures Int            @default(0)
  staleSince          DateTime?
  removedRecordsJson  String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([providerAuthority, zoneId, canonicalName, recordType])
  @@index([ddnsBindingId])
  @@index([serverGroupId])
}
