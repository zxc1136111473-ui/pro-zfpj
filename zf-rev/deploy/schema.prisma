model TicketTopic {
  id            Int      @id @default(autoincrement())
  name          String   // 主题名称，如"续费"、"通用咨询"
  placeholder   String   // 用户填写时的提示文本
  description   String?  // 主题描述
  isActive      Boolean  @default(true) // 是否启用
  sortOrder     Int      @default(0) // 排序顺序
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  tickets       Ticket[]
  
  @@index([isActive])
  @@index([sortOrder])
}

model Ticket {
  id              Int            @id @default(autoincrement())
  subscriptionId  Int            // 创建工单的用户
  topicId         Int            // 工单主题
  title           String         // 工单标题
  status          TicketStatus   @default(UserSubmitted) // 工单状态
  priority        Int            @default(0) // 优先级，用于排序
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  closedAt        DateTime?      // 关闭时间
  autoCloseAt     DateTime?      // 自动关闭时间
  
  subscription    Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  topic           TicketTopic    @relation(fields: [topicId], references: [id])
  messages        TicketMessage[]
  
  @@index([subscriptionId])
  @@index([topicId])
  @@index([status])
  @@index([priority, createdAt])
  @@index([autoCloseAt])
}

model TicketMessage {
  id            Int              @id @default(autoincrement())
  ticketId      Int              // 关联工单
  authorId      Int              // 消息作者ID
  authorType    TicketAuthorType // 作者类型: User 或 Admin
  content       String           // 消息内容
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  ticket        Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author        Subscription     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}

model ForwarderEndpointGroup {
  id               Int      @id @default(autoincrement())
  name             String   @unique  // 组名称（唯一）
  displayName      String   // 组显示名称
  description      String?  // 组描述
  endpointIds      Int[]    // 包含的转发端点ID数组
  autoDetachedEndpointIds Int[] @default([]) // #574: offline auto members, restored on fresh heartbeat
  tokenId          String?  // legacy plaintext enrollment bearer; NULL after seal/rotate/revoke
  // P0-B group enrollment credential (envelope)
  enrollmentLookup     String?   @unique // sha256 hex of bearer
  enrollmentSecretEnc  String?           // enc1... AAD=group_fwd|{id}
  enrollmentEnabled    Boolean   @default(true)
  enrollmentCreatedAt  DateTime?
  enrollmentRotatedAt  DateTime?
  enrollmentRevokedAt  DateTime?
  enrollmentLastUsedAt DateTime?
  allowAutoAddFwd  Boolean  @default(false)  // 是否允许自动添加转发端点
  autoAddFwdServePort    Int?     @default(22222)  // 自动添加转发端点时的默认服务端口
  autoAddFwdAllowIpv6    Boolean  @default(false)  // 自动添加转发端点时是否允许IPv6
  autoAddFwdTrafficScale Float?   // 自动添加转发端点时的流量倍率
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // 多租户：所属租户（null=平台）
  tenantId         Int?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([name])
  @@index([tokenId])
  @@index([tenantId])
}

model ForwardChain {
  id          Int      @id @default(autoincrement())
  name        String   @unique  // 转发链名称（唯一）
  displayName String   // 转发链显示名称
  description String?  // 转发链描述
  groupIds    Int[]    // 转发端点组ID数组（有序）
  isEnabled   Boolean  @default(true) // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 多租户：所属租户（null=平台）。创建后不可变。
  tenantId    Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([isEnabled])
  @@index([tenantId])
}

model ServerGroup {
  id               Int               @id @default(autoincrement())
  name             String            @unique  // 服务器组名称（唯一）
  displayName      String            // 服务器组显示名称
  description      String?           // 服务器组描述
  tokenId          String?           // legacy plaintext enrollment bearer; NULL after seal/rotate/revoke
  // P0-B group enrollment credential (envelope)
  enrollmentLookup     String?   @unique // sha256 hex of bearer
  enrollmentSecretEnc  String?           // enc1... AAD=group_srv|{id}
  enrollmentEnabled    Boolean   @default(true)
  enrollmentCreatedAt  DateTime?
  enrollmentRotatedAt  DateTime?
  enrollmentRevokedAt  DateTime?
  enrollmentLastUsedAt DateTime?
  ingressAddress   String?           // 服务器组入口地址 ip地址或者域名
  portStart        Int?
  portEnd          Int?
  
  // 自动添加控制字段
  allowAutoAdd         Boolean  @default(false)  // 是否允许自动添加服务器
  autoAddAllowForward  Boolean  @default(true)   // 自动添加服务器时是否允许转发
  autoAddAllowLatencyTest Boolean @default(false) // 自动添加服务器时是否允许延迟测试
  autoAddTrafficScale  Float?   @default(1.0)    // 自动添加服务器时的流量倍率
  autoAddAllowIpNum    Int?                      // 自动添加服务器时的IP数量限制
  autoAddAllowConnNum  Int?                      // 自动添加服务器时的连接数限制
  autoAddProtocolFilters String[] @default([])   // 自动添加服务器时的协议过滤器
  autoAddBandwidth     Int?                      // 自动添加服务器时的带宽限制
  autoAddUpBandwidth   Int?                      // 自动添加服务器时的上行带宽限制
  autoAddDownBandwidth Int?                      // 自动添加服务器时的下行带宽限制
  autoAddBwLimitType   BwLimitType?              // 自动添加服务器时的带宽限制类型
  autoAddEnableFwdChainMode Boolean?             // 自动添加是否允许使用转发链
  autoAddForceUsingFwd      Boolean?             // 自动添加是否强制必须使用转发端点
  autoAddAllowInboundProxy  Boolean  @default(false) // 自动添加服务器时是否允许入站代理

  // 入站协议策略(实时组策略，成员服务器 Inherit 时继承)
  allowedInboundProtocols String[] @default([])    // 组入站协议白名单：空=放开全部7种；非空=白名单
  forceInboundProxy       Boolean  @default(false)  // 组强制入站代理：禁止裸转发端口

  // DNS 自动切换配置
  dnsAutoSwitchEnabled      Boolean  @default(false)       // 总开关
  dnsObserveOnly            Boolean  @default(true)        // 观测模式(只记日志不执行DNS变更)
  dnsApiConfigId            Int?                            // 关联的DnsApiConfig ID
  dnsZoneId                 String?                         // DNS zone ID
  dnsRecordTtl              Int?     @default(60)           // DNS记录TTL(秒)
  dnsMinServers             Int?     @default(1)            // DNS中最少保留的IP数量
  // 健康判定 - 延迟监控维度
  dnsPacketLossThreshold    Int?     @default(50)           // 单个目标丢包率阈值(0-100)
  dnsLatencyThresholdMs     Int?                            // 单个目标延迟阈值(毫秒,可选)
  // 健康判定 - 连接映射维度
  dnsFwdFailRateThreshold   Int?     @default(50)           // 单个转发端点失败率阈值(0-100)
  // 健康判定 - "多数不健康"配置
  dnsBadTargetRatioThreshold Int?    @default(60)           // 不健康目标占比阈值(0-100),超过此比例才判定整机降级
  dnsMinSampleCount         Int?     @default(2)            // 最少需要的监测目标/转发端点数量,低于此数量不做判定
  dnsMetricsMaxAgeSec       Int?     @default(600)          // 指标最大有效期(秒),超过则视为过期数据不参与判定
  // 离线宽限
  dnsOfflineGraceSec        Int?     @default(300)          // worker离线后等待的宽限时间(秒),之后才开始降级计数
  // 稳定性确认
  dnsCheckIntervalSec       Int?     @default(120)          // 检查间隔(秒)
  dnsRemovalConfirmCount    Int?     @default(3)            // 连续N次不健康才移除
  dnsRecoveryConfirmCount   Int?     @default(3)            // 连续N次健康才恢复
  dnsCooldownSec            Int?     @default(300)          // 同一IP变更冷却时间(秒)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  // 关联的服务器
  servers          OutboundEndpoint[]
  // DDNS claim 反向（GroupAutoSwitch 占用）
  dnsClaims        DnsRecordClaim[]

  // 多租户：所属租户（null=平台）
  tenantId         Int?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([name])
  @@index([tokenId])
  @@index([tenantId])
}

model PaymentMethod {
  id            Int         @id @default(autoincrement())
  name          String      // 用户自定义名称，如"主要支付宝通道"
  displayName   String      // 显示名称
  type          PaymentType // 支付类型枚举（如 EPAY EPUSDT
  apiUrl        String      // API地址
  merchantId    String      // 商户ID/PID
  merchantKey   String      // 商户密钥（应加密存储）
  feeRate       Int?        // 费率 x% cents 比如 105 标识 1.05% 费率
  notifyUrl     String?     // 异步通知地址
  returnUrl     String?     // 跳转通知地址
  isEnabled     Boolean     @default(true) // 是否启用
  sortOrder     Int         @default(0) // 排序顺序
  network       UsdtNetwork?  // 加密货币网络
  description   String?     // 描述说明
  isSystem      Boolean     @default(false) // 是否为系统管理的支付方式（如余额支付）
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // 关联的支付记录
  payments      Payment[]

  @@index([type])
  @@index([isEnabled])
  @@index([sortOrder])
  @@index([isSystem])
}

enum UsdtNetwork {
  USDTTrc20
  USDTPolygon
}

enum PaymentType {
  EPAY     // 易支付
  ZPAY     // Z支付
  EPUSDT   // 加密货币
  BALANCE  // 余额支付
}

enum OrderType {
  SUBSCRIPTION_RENEWAL        // 订阅续费
  SUBSCRIPTION_PURCHASE       // 订阅购买
  TRAFFIC_RESET              // 流量重置
  TRAFFIC_TOPUP              // 流量包补充（用完自动买流量包）
  BALANCE_RECHARGE           // 余额充值
  REDEEM_CODE_RECHARGE       // 兑换码充值
  SUBSCRIPTION_EXTEND        // 兑换码延长订阅时长（0 元订单，不计入收入）
  BALANCE_REFUND             // 余额退款
  ADMIN_BALANCE_ADJUSTMENT   // 管理员余额调整
}

enum OrderStatus {
  PENDING     // 待支付
  COMPLETED   // 已完成
  CANCELLED   // 已取消/关闭
}

enum PaymentStatus {
  PENDING     // 待支付
  PROCESSING  // 处理中
  COMPLETED   // 已完成
  FAILED      // 失败
  CANCELLED   // 已取消
}

enum RedeemCodeType {
  BALANCE_RECHARGE     // 余额充值类型
  PACKAGE_REDEEM       // 套餐兑换类型
  SUBSCRIPTION_EXTEND  // 延长订阅时长类型
}

enum RedeemCodeStatus {
  ACTIVE     // 可用
  USED       // 已使用
  EXPIRED    // 已过期
  DISABLED   // 已禁用
}

model Order {
  id                Int           @id @default(autoincrement())
  orderNumber       String        @unique // 订单号，用于对外显示
  type              OrderType     // 订单类型
  status            OrderStatus   @default(PENDING) // 订单状态

  // 用户关联
  subscriptionId    Int           // 关联的订阅用户
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // 订单金额
  amount            Int           // 订单金额（分）
  currency          String        @default("CNY") // 货币类型

  // 关联的套餐或订阅信息
  packageId         Int?          // 关联的套餐ID（购买新订阅时）
  package           Package?      @relation(fields: [packageId], references: [id])
  renewalDays       Int?          // 续费天数（续费订阅时）
  renewalPeriodUnit  Int?          // 续费周期单位快照: 0=DAY, 1=MONTH, 2=QUARTER, 3=YEAR
  renewalPeriodCount Int?          // 续费周期数值快照

  // 扩展订单字段
  trafficResetAmount BigInt?       // 流量重置量（字节）
  extensionDays     Int?          // 延期天数（延期订阅时）
  originalAmount    Int?          // 原始金额（分，支持优惠场景）
  discountAmount    Int?          // 优惠金额（分）

  // 兑换码相关字段
  redeemCodeId      Int?          // 关联的兑换码ID
  redeemCode        RedeemCode?   @relation(fields: [redeemCodeId], references: [id])

  // 退款关联（唯一约束：每个原始订单最多一笔退款，数据库兜底防并发双退）
  relatedOrderId    Int?          @unique // 退款订单指向原始充值订单
  relatedOrder      Order?        @relation("OrderRefund", fields: [relatedOrderId], references: [id])
  refundOrders      Order[]       @relation("OrderRefund")

  // 管理员备注
  adminNote         String?       // 管理员操作原因/备注

  // 订单描述
  title             String        // 订单标题
  description       String?       // 订单描述

  // 时间戳
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?     // 完成时间

  // 关联的支付记录
  payments          Payment[]

  // 多租户：创建时快照购买者的租界（null=平台）
  tenantId          Int?
  tenant            Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([subscriptionId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([packageId])
  @@index([redeemCodeId])
  @@index([tenantId])
}

model Payment {
  id                Int           @id @default(autoincrement())
  paymentNumber     String        @unique // 支付流水号

  // 关联订单
  orderId           Int           // 关联的订单ID
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 支付信息
  amount            Int           // 支付金额（分）
  currency          String        @default("CNY") // 货币类型
  status            PaymentStatus @default(PENDING) // 支付状态
  payUrl            String?       // 支付链接
  transactionData   String?       // 支付请求返回的数据

  // 支付方式信息
  paymentMethodId   Int?          // 使用的支付方式ID
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentType       PaymentType?  // 支付类型

  // 第三方支付信息
  externalOrderId   String?       // 第三方支付订单ID
  externalTradeNo   String?       // 第三方交易号
  callbackData      String?       // 支付回调数据（JSON格式）

  // 时间戳
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?     // 支付完成时间

  @@index([orderId])
  @@index([status])
  @@index([paymentMethodId])
  @@index([externalOrderId])
  @@index([externalTradeNo])
  @@index([createdAt])
}

model RedeemCode {
  id                Int               @id @default(autoincrement())
  code              String            @unique // 兑换码
  type              RedeemCodeType    // 兑换码类型
  status            RedeemCodeStatus  @default(ACTIVE)
  
  // 兑换码价值
  value             Int               // 价值金额（分）
  currency          String            @default("CNY")
  
  // 套餐兑换相关
  packageId         Int?              // 关联的套餐ID（套餐兑换类型时使用）
  package           Package?          @relation(fields: [packageId], references: [id])

  // 延长订阅相关
  extensionDays     Int?              // 延长天数（仅 SUBSCRIPTION_EXTEND 类型使用）

  // 使用信息
  usedBy            Int?              // 使用者订阅ID
  usedAt            DateTime?         // 使用时间
  user              Subscription?     @relation(fields: [usedBy], references: [id])
  
  // 有效期
  validFrom         DateTime          @default(now())
  validUntil        DateTime?         // 过期时间（可选）
  
  // 创建信息
  createdBy         Int?              // 创建者（管理员）
  batchId           String?           // 批次ID（用于批量生成）
  description       String?           // 描述
  
  // 关联的订单
  orders            Order[]

  // 多租户：所属租户（null=平台）。兑换校验要求 code.tenantId == user.tenantId
  tenantId          Int?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([code])
  @@index([type])
  @@index([status])
  @@index([usedBy])
  @@index([batchId])
  @@index([validUntil])
  @@index([packageId])
  @@index([tenantId])
}



enum AlertSeverity {
  Info
  Warn
  Critical
}

enum AlertStatus {
  Active
  AutoResolved
  ManualResolved
  Ignored
  /// 点事件：一次写入的历史行，不进 Active，resolved_at 落创建时刻
  PointEvent
}

enum AlertResourceType {
  System
  Subscription
  OutboundEndpoint
  ServerGroup
  ForwardEndpoint
  ForwarderEndpointGroup
  Port
  ForwardChain
  SslCertificate
}

enum AlertReason {
  ServerDown
  ServerHighLatency
  PortAbnormal
  TrafficExceeded
  BalanceLow
  LicenseExpiring
  PaymentFailed
  SystemError
  FwdDown
  HttpConfigAbnormal
  FwdAuthFailure
  PortAutoDeleted
  Custom
  SslCertIssueFailed
  SslCertRenewFailed
  SslCertExpiring
  DnsAutoSwitchFailed      // DNS更新操作失败
  DnsServerRemoved         // 服务器IP被自动从DNS移除
  CpuHighLoad              // CPU持续高负载
  MemoryHighUsage          // 内存持续高使用率
  DiskSpaceLow             // 磁盘空间不足
  ConnectionCountHigh      // 连接数过高
  IngressIpChanged         // 服务器入口 IP 变更（点事件）
  DdnsUpdateFailed         // DDNS 记录更新失败（状态型告警）
  ProcessCrash             // 进程 panic / OOM（点事件；details.kind 区分）
  ControlPlaneNetworkAbnormal       // 控制面自身外网异常：TCP 连通 / DNS 解析（状态型）
  ControlPlaneDependencyUnreachable // 控制面关键依赖不可达：TG API / auth server 等（状态型）
}

model Alert {
  id               Int               @id @default(autoincrement())
  message          String?
  reason           AlertReason
  severity         AlertSeverity     @default(Warn)

  // 资源归属（多态引用：类型 + id）
  resourceType     AlertResourceType
  resourceId       Int?
  resourceName     String?
  subscriptionId Int? // belong to which subscription user
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // 租界历史快照裸列（null=平台）。无 @relation/无 FK（同 AuditLog 手法）。
  // 租户删除后历史告警保留且 tenantId 可悬空；不入 TenantBlockers、不 Cascade。
  // 写入点：alert_model::trigger()/auto_process() 按 (resourceType, reason) 矩阵解析一次落库。
  tenantId         Int?

  // 去重键：同一资源+原因，应计算出稳定 dedupKey
  dedupKey         String
  isOpen           Boolean           @default(true)
  status           AlertStatus       @default(Active)

  occurrenceCount  Int               @default(1)
  firstOccurredAt  DateTime          @default(now())
  lastOccurredAt   DateTime          @default(now())

  // 确认与关闭
  resolvedAt       DateTime?

  // 扩展
  details          String?           // 建议放 JSON 字符串，便于自定义结构
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // ---- 双槽投递 pending（§6.4 / §6.5；R4-P1-5）----
  // Raised 与 Resolved 各一组固定列，互不覆盖。PointEvent 只写 Raised 槽。
  // 清理 CAS 必须带对应槽 eventId，防旧 scanner 误清新事件。
  // snapshotJson：该阶段不可变 payload（防 E1 未扫即 E2 时用当前行冒充 Raised）。
  raisedEventId         String?
  raisedTgPending       Boolean          @default(false)
  raisedEmailPending    Boolean          @default(false)
  raisedSnapshotJson    String?
  // 有界投递状态（ops-email-delivery-bounded-resurrection v12 §3）
  // attempts=纯预算；epoch=纯 fencing（admission 无条件+1、永不回退）
  raisedEmailAttempts       Int       @default(0)
  raisedEmailEpoch          Int       @default(0)
  raisedEmailNextAt         DateTime?
  raisedEmailFailedTo       String?   // JSON 数组：NULL=未试；"[]"=全成功；非空=失败子集
  raisedEmailStateEventId   String?   // attempts/nextAt/failedTo 归属事件；失配=换代
  resolvedEventId       String?
  resolvedTgPending     Boolean          @default(false)
  resolvedEmailPending  Boolean          @default(false)
  resolvedSnapshotJson  String?
  resolvedEmailAttempts       Int       @default(0)
  resolvedEmailEpoch          Int       @default(0)
  resolvedEmailNextAt         DateTime?
  resolvedEmailFailedTo       String?
  resolvedEmailStateEventId   String?

  @@index(subscriptionId)
  @@index([status])
  @@index([resourceType, resourceId])
  @@index([reason])
  @@index([createdAt])
  @@index([tenantId])
}

enum ForwarderTaskStatus {
  Pending
  InProgress
  Completed
  Failed
  Timeout
}

model ForwarderTask {
  id                   Int                 @id @default(autoincrement())
  forwardEndpointId    Int                 // 关联的转发端点ID
  forwardEndpoint      ForwardEndpoint     @relation(fields: [forwardEndpointId], references: [id], onDelete: Cascade)
  
  // 任务内容和配置
  taskJson             String              // 任务内容JSON字符串
  taskType             String              // 任务类型标识
  priority             Int                 @default(0) // 任务优先级，数字越大优先级越高
  dedupKey             String              // 去重ID
  
  // 任务状态和时间
  status               ForwarderTaskStatus @default(Pending)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  timeoutAt            DateTime?           // 任务超时时间
  startedAt            DateTime?           // 任务开始执行时间
  completedAt          DateTime?           // 任务完成时间
  
  // 执行结果
  result               String?             // 任务执行结果JSON字符串
  errorMessage         String?             // 错误信息
  retryCount           Int                 @default(0) // 重试次数
  maxRetries           Int                 @default(3) // 最大重试次数
  
  @@index([forwardEndpointId])
  @@index([status])
  @@index([priority, createdAt])
  @@index([timeoutAt])
  @@index([taskType])
  @@index([forwardEndpointId, status])
}

model PeerStatistic {
  id                Int      @id @default(autoincrement())
  peerPairJson      String   // JSON 序列化的 PeerPair 数据
  statisticJson     String   // JSON 序列化的 TargetStatistic 数据
  lastUpdateTime    DateTime @updatedAt
  createdAt         DateTime @default(now())
  
  @@unique([peerPairJson])
  @@index([lastUpdateTime])
}

model NatTraversal {
    id                Int      @id @default(autoincrement())
    serverId Int
    clientId Int
    publicPort Int
    natPublicPort Int
    natBindPort Int
    token    String   @unique
    target   String
    listenAddress     String?  // 监听地址，可选字段，默认为null表示使用UNSPECIFIED
    lastUpdateTime    DateTime @updatedAt
    createdAt         DateTime @default(now())

    // 多租户：所属租户（null=平台）。必须直接列（serverId/clientId 无 @relation）。
    tenantId          Int?
    tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

    @@index([serverId, clientId])
    @@index([tenantId])
}

model WgNetwork {
    id               Int       @id @default(autoincrement())
    name             String
    displayName      String    @default("")
    addressRange     String    // CIDR, e.g. "10.10.0.0/24"
    listenPort       Int       @default(51820)
    serverPrivateKey String    // gateway x25519 private key, base64
    serverPublicKey  String    // gateway corresponding public key, base64
    dns              String?   // e.g. "1.1.1.1,8.8.8.8"
    mtu              Int?      @default(1380)
    gatewayServerId  Int       @map("serverId") // FK to OutboundEndpoint, DB column stays "serverId"
    gatewayEndpoint  String?   // extra WG listen endpoint(s), e.g. "1.2.3.4:51820", comma-separated
    hammerListenPort Int?      // Hammer protocol listen port for gateway (null=disabled)
    hammerUotPort    Int?      // Hammer UOT listen port for gateway (null=disabled)
    hammerPsk        String?   // Hammer PSK for gateway authentication
    p2pMode          Int       @default(0)      // [reserved] 0=gateway-only, 1=p2p+fallback, 2=p2p-only
    exitNode         Boolean   @default(false)  // when true, route all traffic (0.0.0.0/0) through gateway
    excludedCidrs    String?   // comma-separated CIDRs excluded from full-tunnel (private/docker nets); applies to exit-node members
    enabled          Boolean   @default(true)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    peers            WgPeer[]
    members          WgMember[]

    // 多租户：WG 归属锚点（null=平台）。子表不加列，经 networkId 归属。
    tenantId         Int?
    tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

    @@unique([gatewayServerId, listenPort])
    @@index([tenantId])
}

model WgPeer {
    id                  Int        @id @default(autoincrement())
    networkId           Int
    network             WgNetwork  @relation(fields: [networkId], references: [id], onDelete: Cascade)
    name                String     // device name, e.g. "iPhone-Alice"
    publicKey           String
    privateKey          String     // stored to generate full client QR config
    presharedKey        String?
    assignedIp          String     // e.g. "10.10.0.2/32"
    allowedIps          String?    // client-side AllowedIPs, defaults to network.addressRange
    persistentKeepalive Int?       @default(25)
    exitNode            Boolean    @default(false) // enable full-tunnel exit
    exitNodeTargetId    Int?       // FK to WgMember used as exit (null=gateway)
    enabled             Boolean    @default(true)
    createdAt           DateTime   @default(now())
    updatedAt           DateTime   @updatedAt
    directMembers       WgPeerDirectMember[]

    @@unique([networkId, assignedIp])
    @@unique([networkId, publicKey])
    @@unique([id, networkId])  // for composite FK from WgPeerDirectMember
}

model WgMember {
    id                  Int        @id @default(autoincrement())
    networkId           Int
    network             WgNetwork  @relation(fields: [networkId], references: [id], onDelete: Cascade)
    serverId            Int        // FK to OutboundEndpoint (member worker)
    name                String     // display label, e.g. "Tokyo-1"
    publicKey           String
    privateKey          String     // stored to generate member config
    presharedKey        String?
    assignedIp          String     // allocated from same pool as WgPeer
    // ── P2P Direct Connect (topology layer) ──
    p2pEnabled          Boolean    @default(false) // [deprecated] kept for migration, use p2pServer/p2pClient
    p2pServer           Boolean    @default(false) // accept direct connections from other members (topology only)
    p2pClient           Boolean    @default(false) // actively connect to other P2P-server-enabled members
    // ── Device Direct Connect ──
    deviceDirectEnabled Boolean    @default(false) // accept direct WG connections from devices
    deviceDirectListenPort Int?    // custom WG listen port for device direct (null=auto-assign when enabled)
    // ── WireGuard Transport ──
    wgServer            Boolean    @default(false) // provide WireGuard transport endpoint for P2P/relay
    endpoint            String?    // WireGuard server endpoint (custom override, auto-detected if empty)
    // ── Exit Node ──
    exitNode            Boolean    @default(false) // use exit node for internet (full-tunnel, "consume exit")
    exitNodeCandidate   Boolean    @default(false) // can serve as exit node for others ("provide exit")
    excludedCidrs       String?    // overrides network-level excluded CIDRs for this member; NULL=inherit network
    enabled             Boolean    @default(true)
    // ── Relay ──
    relayEnabled        Boolean    @default(false) // can this member act as a relay for others
    autoRelayCandidate  Boolean    @default(false) // allow auto-selection as relay
    // ── Hammer Transport ──
    hammerListenPort    Int?       // Hammer protocol listen port (null=disabled)
    hammerUotPort       Int?       // Hammer UOT listen port (null=disabled)
    hammerPsk           String?    // Hammer pre-shared key for authentication (null=auto-generated)
    forceHammer         Boolean    @default(false) // [deprecated] kept for migration, use hammerOnly
    hammerServer        Boolean    @default(false) // provide Hammer/UOT relay service for other members
    hammerOnly          Boolean    @default(false) // outbound only uses Hammer/UOT protocols (disables WG_UDP + P2P)
    createdAt           DateTime   @default(now())
    updatedAt           DateTime   @updatedAt
    relayEdgesFrom      WgRelayEdge[] @relation("EdgeFrom")
    relayEdgesTo        WgRelayEdge[] @relation("EdgeTo")
    exitTargets         WgExitTarget[] @relation("ExitTargets")
    exitTargetOf        WgExitTarget[] @relation("ExitTargetOf")
    directFromPeers     WgPeerDirectMember[]

    @@unique([networkId, serverId])
    @@unique([networkId, assignedIp])
    @@unique([networkId, publicKey])
    @@unique([id, networkId])  // for composite FK from WgRelayEdge
}

enum WgEdgeProtocol {
    WG_UDP
    HAMMER_UDP
    HAMMER_UOT
}

/// Same-network enforced at DB level: both composite FKs share the single networkId
/// column, so fromMember and toMember are guaranteed to belong to the same network.
model WgRelayEdge {
    id                Int              @id @default(autoincrement())
    networkId         Int              // shared by both composite FKs below
    fromMemberId      Int
    fromMember        WgMember         @relation("EdgeFrom", fields: [fromMemberId, networkId], references: [id, networkId], onDelete: Cascade)
    toMemberId        Int
    toMember          WgMember         @relation("EdgeTo", fields: [toMemberId, networkId], references: [id, networkId], onDelete: Cascade)
    priority          Int              @default(0)  // lower = higher priority
    protocol          WgEdgeProtocol   @default(WG_UDP)
    wgEndpoints       String?          // JSON array override for WG UDP endpoints; null = auto-resolve
    hammerEndpoints   String?          // JSON array override for Hammer endpoints; null = auto-resolve
    hammerUotPriority Int?             // UOT priority for HAMMER_UOT edges (lower = prefer UOT)
    enabled           Boolean          @default(true)
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt

    @@unique([fromMemberId, toMemberId, protocol])
    @@index([fromMemberId])
    @@index([toMemberId])
    @@index([networkId])
}

/// Exit node target: a member selects another member as its exit node (with priority for fallback).
/// Device-to-Member direct connect mapping.
/// Same-network enforced via composite FKs sharing the single networkId column.
model WgPeerDirectMember {
    id         Int      @id @default(autoincrement())
    networkId  Int
    peerId     Int
    peer       WgPeer   @relation(fields: [peerId, networkId], references: [id, networkId], onDelete: Cascade)
    memberId   Int
    member     WgMember @relation(fields: [memberId, networkId], references: [id, networkId], onDelete: Cascade)
    enabled    Boolean  @default(true)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([peerId, memberId])
    @@index([peerId])
    @@index([memberId])
    @@index([networkId])
}

model WgExitTarget {
    id              Int       @id @default(autoincrement())
    networkId       Int
    memberId        Int
    member          WgMember  @relation("ExitTargets", fields: [memberId, networkId], references: [id, networkId], onDelete: Cascade)
    targetMemberId  Int
    targetMember    WgMember  @relation("ExitTargetOf", fields: [targetMemberId, networkId], references: [id, networkId], onDelete: Cascade)
    priority        Int       @default(0)  // lower = higher priority
    enabled         Boolean   @default(true)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@unique([memberId, targetMemberId])
    @@index([memberId])
    @@index([targetMemberId])
    @@index([networkId])
}

model DnsApiConfig {
  id            Int             @id @default(autoincrement())
  name          String          @unique // 配置名称，用于标识
  displayName   String          // 显示名称
  provider      DnsProviderType // DNS厂商类型
  apiConfig     String          // JSON格式的API配置信息（包含API密钥、端点等）
  isEnabled     Boolean         @default(true) // 是否启用
  description   String?         // 描述信息
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sslCertificates  SslCertificate[] // reverse relation for ref checking on delete
  ddnsBindings     DdnsBinding[]    // DDNS 绑定引用
  dnsClaims        DnsRecordClaim[] // claim 执行凭据引用

  @@index([provider])
  @@index([isEnabled])
}

model InvitationCode {
  id            Int           @id @default(autoincrement())
  code          String        @unique // 邀请码字符串（用户可自定义）
  maxUses       Int           @default(1) // 最大使用次数
  usedCount     Int           @default(0) // 已使用次数
  isEnabled     Boolean       @default(true) // 是否启用
  expiresAt     DateTime?     // 过期时间（可选）
  createdBy     Int?          // 创建者（管理员订阅ID）
  description   String?       // 描述
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // 关联的使用记录
  usedBy        InvitationCodeUsage[]
  
  @@index([code])
  @@index([isEnabled])
  @@index([expiresAt])
}

model InvitationCodeUsage {
  id                Int              @id @default(autoincrement())
  invitationCodeId  Int              // 关联的邀请码ID
  subscriptionId    Int              // 使用者订阅ID
  usedAt            DateTime         @default(now()) // 使用时间
  
  invitationCode    InvitationCode   @relation(fields: [invitationCodeId], references: [id], onDelete: Cascade)
  subscription      Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  @@unique([invitationCodeId, subscriptionId]) // 防止同一邀请码被同一用户多次使用
  @@index([invitationCodeId])
  @@index([subscriptionId])
}
// 解锁服务配置模型
model UnlockServiceConfig {
  id               Int      @id @default(autoincrement())
  name             String   @unique // 服务名称（唯一标识）
  displayName      String   // 显示名称

  // 脚本配置（二选一）
  scriptUrl        String?  // 测试脚本URL
  scriptContent    String?  @db.Text // 直接提供的脚本内容

  // 脚本类型
  scriptType       UnlockScriptType // python 或 bash

  // 测试配置
  timeout          Int      @default(30000) // 超时时间（毫秒），默认30秒
  cacheExpiration  Int      @default(28800000) // 缓存时间（毫秒），默认8小时
  scriptParams     String[] @default([]) // 脚本参数 (可选)

  // 状态控制
  isEnabled        Boolean  @default(true)  // 是否启用

  // UI展示字段
  icon             String?  // 图标URL或名称
