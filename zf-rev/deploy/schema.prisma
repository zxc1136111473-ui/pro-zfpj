  defaultInboundFirewallRuleSet   FirewallRuleSet? @relation("PackageDefaultInboundFirewall", fields: [defaultInboundFirewallRuleSetId], references: [id], onDelete: SetNull)
  inboundFirewallRequired         Boolean?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // 多租户：所属租户（null=平台）。isPublic 语义收窄为"租界内公开"
  tenantId              Int?
